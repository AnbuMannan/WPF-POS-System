<Window x:Class="POS.UI.Modules.Billing.DraftBills.DraftBillsListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draft Bills" Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushWindowBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Draft Bills" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding DraftBills}"
                  SelectedItem="{Binding SelectedDraftBill}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Bill #" Width="140" Binding="{Binding BillNumber}"/>
                <DataGridTextColumn Header="Draft Name" Width="*" Binding="{Binding DraftName}"/>
                <DataGridTextColumn Header="Created At" Width="150" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding TotalAmount, StringFormat='₹ {0:N2}'}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Delete" Width="100" Height="40" Margin="0,0,10,0"
                    Background="{StaticResource BrushAccentRed}" Foreground="White"
                    Command="{Binding DeleteCommand}"/>
            <Button Content="Retrieve" Width="120" Height="40"
                    Style="{StaticResource PrimaryButton}" Command="{Binding RetrieveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

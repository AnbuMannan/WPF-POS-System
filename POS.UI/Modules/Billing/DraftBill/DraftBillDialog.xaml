<Window x:Class="POS.UI.Modules.Billing.DraftBill.DraftBillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Draft" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Save as Draft" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Draft Name (optional):" Margin="0,0,0,5"/>
            <TextBox x:Name="DraftNameTextBox" Height="34" Margin="0,0,0,15"/>
            
            <TextBlock Text="Notes:" Margin="0,0,0,5"/>
            <TextBox x:Name="NotesTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource BrushTextSecondary}" 
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Content="Save Draft" Width="120" Height="40"
                    Style="{StaticResource PrimaryButton}" Click="SaveDraft_Click"/>
        </StackPanel>
    </Grid>
</Window>

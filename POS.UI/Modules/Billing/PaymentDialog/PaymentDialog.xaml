<Window x:Class="POS.UI.Modules.Billing.PaymentDialog.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:POS.UI.Core.Converters"
        xmlns:local="clr-namespace:POS.UI.Modules.Billing.PaymentDialog"
        Title="Payment" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}"
        FocusManager.FocusedElement="{Binding ElementName=txtAmountTendered}">
    <Window.Resources>
        <conv:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Total Amount Display -->
        <Border Grid.Row="0" Background="{StaticResource BrushAccentGreen}" Padding="20,15" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOTAL AMOUNT" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₹ {0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Cash payment: tendered amount and change -->
        <GroupBox Grid.Row="1" Header="Cash (enter amount received, we will show change)" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Amount Tendered:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtAmountTendered" TabIndex="0"
                         Text="{Binding CashTenderedText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,8" Padding="8,6" FontSize="14" VerticalContentAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Add Cash Payment" Margin="8,0,0,8"
                        Style="{StaticResource PrimaryButton}" TabIndex="1" IsDefault="True"
                        Command="{Binding AddCashPaymentCommand}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Change to give: ₹ " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChangeAmountText}" Foreground="{StaticResource BrushAccentGreen}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Payment methods (one-click full) and split -->
        <GroupBox Grid.Row="2" Header="Payment Methods" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Pay full amount with one method:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Card (full)" Height="40" Margin="0,0,8,0" FontSize="14"
                            Style="{StaticResource SecondaryButton}" Command="{Binding AddCardPaymentCommand}"/>
                    <Button Content="UPI (full)" Height="40" FontSize="14"
                            Style="{StaticResource SecondaryButton}" Command="{Binding AddUPIPaymentCommand}"/>
                </StackPanel>
                <Border Height="1" Background="#E0E0E0" Margin="0,12,0,12"/>
                <TextBlock Text="Or add a partial payment (for split):" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Amount:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SplitAmountText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="6,4" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Method:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="3" SelectedItem="{Binding SplitMethod}" Margin="0,0,8,0" Height="28" MinWidth="80"
                              ItemsSource="{Binding Source={x:Static Member=local:PaymentDialogViewModel.PaymentMethodOptions}}"/>
                    <Button Grid.Column="4" Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddSplitPaymentCommand}"/>
                </Grid>
                <TextBlock Text="Payments added (Card/UPI full or split entries below):" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource BrushTextPrimary}"/>
                <Border MinHeight="100" MaxHeight="180" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1" Background="#1E1E1E" CornerRadius="4" Padding="8">
                    <ListBox ItemsSource="{Binding CompletedPayments}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="#2D2D2D" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PaymentMethod}" FontWeight="SemiBold" Margin="0,0,16,0" MinWidth="56" Foreground="White"/>
                                        <TextBlock Text="{Binding Amount, StringFormat='₹ {0:N2}'}" Foreground="{StaticResource BrushAccentGreen}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- Payment Summary -->
        <Border Grid.Row="3" Background="{StaticResource BrushCardBg}" Padding="15" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Paid:" FontSize="14" Margin="0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalPaid, StringFormat='₹ {0:N2}'}" FontSize="14" FontWeight="SemiBold" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Balance:" FontSize="14" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Balance, StringFormat='₹ {0:N2}'}" FontSize="14" FontWeight="SemiBold" Margin="0,4"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click" TabIndex="3"/>
            <Button Content="Complete Sale" Width="140" Height="40"
                    Style="{StaticResource PrimaryButton}" Command="{Binding CompleteSaleCommand}" TabIndex="2"/>
        </StackPanel>
    </Grid>
</Window>

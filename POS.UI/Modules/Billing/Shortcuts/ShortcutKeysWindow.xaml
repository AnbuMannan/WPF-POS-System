<Window x:Class="POS.UI.Modules.Billing.Shortcuts.ShortcutKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Keyboard Shortcuts" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Function Keys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="F1" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus Search / Find Product" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="F2" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Hold Bill" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="F3" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Save as Draft" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="F4" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Clear Cart" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="F5" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Reload Customers" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="F9" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Show Held Bills" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="F10" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Show Draft Bills" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="F11" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Toggle Full Screen" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="F12" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Proceed to Payment" Margin="0,5"/>
                </Grid>

                <Border Height="1" Background="#E0E0E0" Margin="0,15"/>

                <TextBlock Text="Ctrl + Key" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+F" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus Search" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+D" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Focus Discount" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+X" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Clear Cart" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+P" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Reprint Last Receipt" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Alt+C" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Focus Customer" Margin="0,5"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Width="120" Height="40" Margin="0,15,0,0"
                Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
    </Grid>
</Window>

<UserControl x:Class="POS.UI.Modules.Billing.QuickSale.QuickSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.UI.Modules.Billing.QuickSale"
             xmlns:conv="clr-namespace:POS.UI.Core.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{StaticResource BrushWindowBg}">

    <UserControl.Resources>
        <conv:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        
        <!-- Premium Touch Product Card -->
        <Style x:Key="ProductCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardBg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="{Binding Name}" 
                                           FontWeight="SemiBold" FontSize="14" 
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}"/>
                                
                                <TextBlock Grid.Row="1" Text="{Binding SellingPrice, Converter={StaticResource DecimalToCurrency}}" 
                                           FontWeight="Bold" FontSize="16" 
                                           Foreground="{StaticResource BrushAccentGreen}" 
                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="Stock: " FontSize="11" Foreground="{StaticResource BrushTextTertiary}"/>
                                    <TextBlock Text="{Binding AvailableStock, StringFormat=N0}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8F9FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BrushPrimaryLight}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Category Pill -->
        <Style x:Key="CategoryPillStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PillBorder" CornerRadius="18" Background="White" 
                                BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1"
                                Padding="18,8" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource BrushPrimary}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" MinWidth="500"/>
            <ColumnDefinition Width="4*" MinWidth="350"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT: PRODUCT CATALOG ==================== -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Premium Barcode Search -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" 
                    BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1"
                    Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBox x:Name="BarcodeSearchBox" Grid.Column="1" 
                             Text="{Binding SearchBarcode, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18" Padding="12" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ScanBarcodeCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="Scan Barcode or SKU (Enter)..." 
                               FontSize="18" Foreground="{StaticResource BrushTextTertiary}" 
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding Text, ElementName=BarcodeSearchBox, Converter={StaticResource StringToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Categories Pill List -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" 
                     SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryPillStyle}"
                     BorderThickness="0" Background="Transparent"
                     Margin="0,0,0,15" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Product Grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProductCardStyle}" 
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ==================== RIGHT: CART & TENDER ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cart Grid (Using Global Style) -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" 
                    BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
                <Grid>
                    <DataGrid ItemsSource="{Binding CartItems}" 
                              Style="{StaticResource {x:Type DataGrid}}"
                              HeadersVisibility="None" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent" RowHeight="55"
                              SelectedItem="{Binding SelectedCartItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                <Setter Property="Height" Value="55"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SKU}" FontSize="11" Foreground="{StaticResource BrushTextTertiary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity, StringFormat=x{0:N0}}" 
                                                   FontWeight="Bold" FontSize="15" 
                                                   VerticalAlignment="Center" Margin="10,0"
                                                   Foreground="{StaticResource BrushPrimary}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource DecimalToCurrency}}" 
                                                   FontWeight="Bold" FontSize="14" 
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Background="Transparent" BorderThickness="0" 
                                                Foreground="{StaticResource BrushAccentRed}" FontSize="18"
                                                Padding="0" VerticalAlignment="Center" Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Premium Totals Box (Mimicking BillingView) -->
            <Border Grid.Row="1" Background="#1B5E20" Padding="20,15" CornerRadius="10" Margin="0,12,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Subtotal" Foreground="#A5D6A7" FontSize="13"/>
                        <TextBlock Text="{Binding Subtotal, Converter={StaticResource DecimalToCurrency}}" 
                                   HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Estimated Tax" Foreground="#A5D6A7" FontSize="13"/>
                        <TextBlock Text="{Binding TaxTotal, Converter={StaticResource DecimalToCurrency}}" 
                                   HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                    </Grid>
                    <Separator Background="#2E7D32" Margin="0,0,0,10"/>
                    <Grid>
                        <TextBlock Text="NET PAYABLE" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, Converter={StaticResource DecimalToCurrency}}" 
                                   HorizontalAlignment="Right" FontSize="28" FontWeight="Bold" Foreground="#81C784"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Premium Fast Tender Buttons -->
            <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                <Button Content="EXACT CASH 💵" Height="65" Margin="0,0,5,5" 
                        Style="{StaticResource SuccessButtonStyle}" FontSize="16" FontWeight="Bold"
                        Command="{Binding QuickPayCommand}" CommandParameter="Cash"/>
                
                <Button Content="CARD / POS 💳" Height="65" Margin="5,0,0,5" 
                        Style="{StaticResource PrimaryButtonStyle}" FontSize="16" FontWeight="Bold"
                        Command="{Binding QuickPayCommand}" CommandParameter="Card"/>
                
                <Button Content="UPI / WALLET 📱" Height="65" Margin="0,5,5,0" 
                        Background="#6A1B9A" Foreground="White" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand"
                        Command="{Binding QuickPayCommand}" CommandParameter="UPI">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4A148C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="CLEAR CART ❌" Height="65" Margin="5,5,0,0" 
                        Style="{StaticResource DangerButtonStyle}" FontSize="16" FontWeight="Bold"
                        Command="{Binding ClearCartCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
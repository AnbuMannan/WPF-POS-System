<Window x:Class="POS.UI.Modules.Billing.CustomerDisplay.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Display" Height="600" Width="400"
        WindowStyle="None" WindowState="Maximized"
        Background="#1B5E20">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Welcome!" FontSize="48" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,30"/>
            
            <Border Background="White" Padding="30" CornerRadius="15" Margin="20">
                <StackPanel>
                    <TextBlock Text="Total Amount" FontSize="24" Foreground="#666" TextAlignment="Center"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" 
                               FontSize="64" FontWeight="Bold" Foreground="#1B5E20" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Thank you for shopping with us!" FontSize="20" Foreground="White" 
                       TextAlignment="Center" Margin="0,30,0,0" Opacity="0.9"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="POS.UI.Modules.Billing.BillingScreen.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.UI.Core.Converters"
             xmlns:productSearch="clr-namespace:POS.UI.Modules.Billing.ProductSearch"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BrushWindowBg}"
             Focusable="True"
             PreviewKeyDown="BillingView_PreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F2" Command="{Binding HoldBillCommand}" />
        <KeyBinding Key="F3" Command="{Binding SaveDraftCommand}" />
        <KeyBinding Key="F4" Command="{Binding ClearCartCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCustomersCommand}" />
        <KeyBinding Key="F9" Command="{Binding ShowHeldBillsCommand}" />
        <KeyBinding Key="F10" Command="{Binding ShowDraftBillsCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
        <KeyBinding Key="F12" Command="{Binding ProceedToPaymentCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding OpenHoldBillDialogCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding OpenDraftBillDialogCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding FocusDiscountCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding ClearCartCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ReprintLastReceiptCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewBillCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ShowHeldBillsCommand}" />
        <KeyBinding Key="C" Modifiers="Alt" Command="{Binding FocusCustomerCommand}" />
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding ProceedToPaymentCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="OemQuestion" Modifiers="Ctrl" Command="{Binding ShowShortcutsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <conv:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:RowIndexToSNoConverter x:Key="SNoConverter"/>
        <conv:TaxRateToBandConverter x:Key="TaxRateToBand"/>
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibility"/>
        <Storyboard x:Key="RowAddedFlash">
            <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                            From="#C8E6C9" To="#00000000" Duration="0:0:0.6">
                <ColorAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="480"/>
                <ColumnDefinition Width="3*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL ==================== -->
        <Grid Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Product search: full-width prominent bar (F1 or Ctrl+F to focus) -->
            <Border Grid.Row="0" Margin="0,0,0,8" ToolTip="Product search – type name, SKU or barcode (F1 or Ctrl+F)">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                <productSearch:ProductSearchControl x:Name="ProductSearchControl" DataContext="{Binding ProductSearch}"/>
            </Border>

            <!-- Quick add hidden – user selects from autosuggest only -->
            <WrapPanel Grid.Row="1" x:Name="QuickProductsPanel" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="Quick add:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold"/>
                <Button Content="Item 1" Margin="0,0,8,8" Padding="12,8" Tag="1" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 2" Margin="0,0,8,8" Padding="12,8" Tag="2" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 3" Margin="0,0,8,8" Padding="12,8" Tag="3" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 4" Margin="0,0,8,8" Padding="12,8" Tag="4" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 5" Margin="0,0,8,8" Padding="12,8" Tag="5" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 6" Margin="0,0,8,8" Padding="12,8" Tag="6" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 7" Margin="0,0,8,8" Padding="12,8" Tag="7" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Item 8" Margin="0,0,8,8" Padding="12,8" Tag="8" Click="QuickProduct_Click" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>

            <!-- Cart DataGrid with empty state overlay -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <DataGrid x:Name="CartTable" TabIndex="5"
                          ItemsSource="{Binding CartItems}"
                          SelectedItem="{Binding SelectedCartItem}"
                          PreviewKeyDown="CartTable_PreviewKeyDown"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          FontSize="13"
                          AlternationCount="2"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1" BorderBrush="{StaticResource BrushBorderSoft}"
                          Background="{StaticResource BrushCardBg}"
                          FrozenColumnCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{x:Null}">
                            <Setter Property="Background" Value="#263238"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="8,10"/>
                            <Setter Property="BorderBrush" Value="#1E272E"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                MinHeight="{TemplateBinding MinHeight}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="White"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="40"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="S.No" Width="60" MinWidth="60" Binding="{Binding LineNumber}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Code" Width="100" MinWidth="90" Binding="{Binding SKU}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Width="*" MinWidth="100" Binding="{Binding ProductName}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="HSN" Width="75" MinWidth="65" Binding="{Binding HSNCode}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Qty" Width="120" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" FontSize="20" FontWeight="Bold" Height="32"
                                                Command="{Binding DecreaseQuantityCommand}" Cursor="Hand"
                                                Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"/>
                                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                                                 VerticalContentAlignment="Center" Height="32" BorderThickness="0"
                                                 Background="Transparent" Padding="2,0"
                                                 PreviewTextInput="QuantityBox_PreviewTextInput"/>
                                        <Button Grid.Column="2" Content="+" FontSize="20" FontWeight="Bold" Height="32"
                                                Command="{Binding IncreaseQuantityCommand}" Cursor="Hand"
                                                Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="UOM" Width="75" MinWidth="65" Binding="{Binding UnitName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="MRP" Width="85" MinWidth="75" Binding="{Binding MRP, StringFormat=N2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Width="90" MinWidth="80" Binding="{Binding ActualPrice, StringFormat=N2}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Disc%" Width="75" MinWidth="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                             BorderThickness="0" Background="Transparent" Padding="4,0"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Disc₹" Width="80" MinWidth="70" Binding="{Binding DiscountAmount, StringFormat=N2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tax%" Width="70" MinWidth="62" Binding="{Binding TaxRate, StringFormat={}{0:N1}%}" IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaxRate, Converter={StaticResource TaxRateToBand}}" Value="0">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TaxRate, Converter={StaticResource TaxRateToBand}}" Value="5">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TaxRate, Converter={StaticResource TaxRateToBand}}" Value="12">
                                            <Setter Property="Background" Value="#F1F8E9"/>
                                            <Setter Property="Foreground" Value="#558B2F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TaxRate, Converter={StaticResource TaxRateToBand}}" Value="18">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="Foreground" Value="#F57C00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TaxRate, Converter={StaticResource TaxRateToBand}}" Value="28">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tax₹" Width="80" MinWidth="70" Binding="{Binding TaxAmount, StringFormat=N2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Width="110" MinWidth="100" Binding="{Binding TotalAmount, StringFormat='₹ {0:N2}'}" IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="70" MinWidth="65" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" ToolTip="Remove item (Delete key)" FontSize="16" Width="40" Height="32"
                                            Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF5350" BorderThickness="1"
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFCDD2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Empty cart state: centered when CartItems.Count == 0 -->
                <Border Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}"
                        Background="{StaticResource BrushCardBg}" Panel.ZIndex="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock Text="🛒" FontSize="72" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,8"/>
                        <TextBlock Text="Cart is empty" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Search for products above or scan barcode to add items"
                                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom summary bar: Subtotal, Tax, and total before round-off; payable amount is in right panel -->
            <Border Grid.Row="3" Background="#1B5E20" Padding="20,12" CornerRadius="8" Margin="0,8,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="Items: " Foreground="White" FontSize="16" Opacity="0.9"/>
                        <TextBlock Text="{Binding CartItems.Count, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="Subtotal: " Foreground="White" FontSize="16" Opacity="0.9"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='₹ {0:N2}'}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0"
                                Visibility="{Binding DiscountAmount, Converter={StaticResource GreaterThanZeroToVisibility}}">
                        <TextBlock Text="Discount: " Foreground="#FFD54F" FontSize="16" Opacity="0.9"/>
                        <TextBlock Text="{Binding DiscountAmount, StringFormat='₹ {0:N2}'}" Foreground="#FFD54F" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="Tax: " Foreground="White" FontSize="16" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalTax, StringFormat='₹ {0:N2}'}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.Column="4"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL: " Foreground="#A5D6A7" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== RIGHT PANEL (compact, no scroll) ==================== -->
        <Grid Grid.Column="1" Margin="10,12,14,12">
            <StackPanel>
                <Border Background="{StaticResource BrushCardBg}" Padding="12" Margin="0,0,0,8"
                        BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Bill #" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding BillNumber, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                        <Button Content="Reserve Bill #" Margin="0,8,0,0" Command="{Binding GenerateBillNumberCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12"
                                ToolTip="Optional: Pre-assign the next bill number (e.g. INV202602000028) so it shows on screen and can be printed on drafts. The sale is only saved when you complete payment (F12); this just reserves the number for display."/>
                    </StackPanel>
                </Border>
                <!-- Keyboard shortcuts hint -->
                <Border Background="#263238" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Foreground="White" FontSize="11" Margin="4,0"><Run Text="F1" FontWeight="Bold"/> Search</TextBlock>
                        <TextBlock Foreground="White" FontSize="11" Margin="4,0"><Run Text="F2" FontWeight="Bold"/> Hold</TextBlock>
                        <TextBlock Foreground="White" FontSize="11" Margin="4,0"><Run Text="F12" FontWeight="Bold"/> Pay</TextBlock>
                        <TextBlock Foreground="White" FontSize="11" Margin="4,0"><Run Text="DEL" FontWeight="Bold"/> Remove</TextBlock>
                    </StackPanel>
                </Border>
                <GroupBox Header="Customer" Padding="8" Margin="0,0,0,6" FontWeight="SemiBold">
                    <StackPanel>
                        <ComboBox x:Name="CustomerCombo" ItemsSource="{Binding Customers}" TabIndex="10"
                                  SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"
                                  IsEditable="True" Height="34" Margin="0,0,0,6" ToolTip="Customer (Alt+C)"/>
                        <Button x:Name="BtnAddCustomer" Content="+ Add Customer" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,6" TabIndex="11" Click="BtnAddCustomer_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Discount" Padding="8" Margin="0,0,0,6" FontWeight="SemiBold">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="%" IsChecked="{Binding IsDiscountByPercent}" GroupName="DiscType" Margin="0,0,16,0" TabIndex="12"/>
                            <RadioButton Content="₹" IsChecked="{Binding IsDiscountByPercent, Converter={StaticResource InverseBool}, Mode=TwoWay}" GroupName="DiscType" TabIndex="13"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DiscountBox" Text="{Binding DiscountInputValue, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Margin="0,0,6,0" Padding="6,0" TabIndex="14" ToolTip="Discount (Ctrl+D)"/>
                            <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyDiscountCommand}" Style="{StaticResource PrimaryButton}" Padding="10,6" TabIndex="15"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Tax Summary" Padding="8" Margin="0,0,0,6" FontWeight="SemiBold">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BillSummary.Subtotal, StringFormat=N2}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BillSummary.DiscountAmount, StringFormat=N2}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="CGST" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BillSummary.CGST, StringFormat=N2}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="SGST" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BillSummary.SGST, StringFormat=N2}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="IGST" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BillSummary.IGST, StringFormat=N2}" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Round Off" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BillSummary.RoundOff, StringFormat=N2}" Margin="0,2"/>
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="1" Height="1" Background="#E0E0E0" Margin="0,6,0,0"/>
                        <Border Grid.Row="2" Background="#E8F5E9" Padding="15,12" CornerRadius="8" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Net Payable" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding BillSummary.GrandTotal, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>
            </StackPanel>
        </Grid>
        </Grid>

        <!-- Visible status bar: full width below content, above action buttons (error = red, success = green) -->
        <Border Grid.Row="1" Padding="14,10" Margin="12,0,12,6" CornerRadius="6" Background="#F0F0F0" BorderThickness="1" BorderBrush="#E0E0E0"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#333333"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Action buttons: horizontal bar below items/subtotal (no scroll) -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBg}" Padding="12,10" Margin="12,8,12,12" CornerRadius="8" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hold Bill (F2)" Height="40" Margin="0,0,8,0" MinWidth="100" TabIndex="20"
                        ToolTip="Hold current bill (F2)" Background="{StaticResource BrushAccentOrange}" Foreground="White" FontWeight="SemiBold"
                        Command="{Binding OpenHoldBillDialogCommand}" Cursor="Hand"/>
                <Button Content="Save Draft (F3)" Height="40" Margin="0,0,8,0" MinWidth="100" TabIndex="21"
                        ToolTip="Save as draft (F3)" Style="{StaticResource PrimaryButton}" FontWeight="SemiBold"
                        Command="{Binding OpenDraftBillDialogCommand}" Cursor="Hand"/>
                <Button Content="Held Bills" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" TabIndex="22"
                        ToolTip="Open held bills (F9)" Command="{Binding ShowHeldBillsCommand}" Cursor="Hand"/>
                <Button Content="Draft Bills" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" TabIndex="23"
                        ToolTip="Open draft bills (F10)" Command="{Binding ShowDraftBillsCommand}" Cursor="Hand"/>
                <Button Content="Clear Cart (F4)" Height="40" Margin="0,0,8,0" MinWidth="100" TabIndex="24"
                        ToolTip="Clear cart (F4)" Background="{StaticResource BrushAccentRed}" Foreground="White" FontWeight="SemiBold"
                        Command="{Binding ClearCartCommand}" Cursor="Hand"/>
                <Button Content="Proceed to Pay (F12)" Height="44" Margin="0,0,0,0" MinWidth="160" FontSize="15" FontWeight="Bold" TabIndex="25"
                        ToolTip="Open payment window (F12 or Alt+P)"
                        Background="{StaticResource BrushAccentGreen}" Foreground="White"
                        Command="{Binding ProceedToPaymentCommand}" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                <TextBlock Text="Please wait..." Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="POS.UI.Modules.Diagnostics.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushWindowBg}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Service Health" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />
            <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Configured Base URLs" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="API (config): " FontWeight="SemiBold" Width="180"/>
                        <TextBlock Text="{Binding ApiBaseUrl}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Auth (config): " FontWeight="SemiBold" Width="180"/>
                        <TextBlock Text="{Binding AuthApiBaseUrl}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="License (config): " FontWeight="SemiBold" Width="180"/>
                        <TextBlock Text="{Binding LicenseBaseUrl}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HttpClient BaseAddress" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="DefaultApi: " FontWeight="SemiBold" Width="180"/>
                        <TextBlock Text="{Binding DefaultApiClientBase}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

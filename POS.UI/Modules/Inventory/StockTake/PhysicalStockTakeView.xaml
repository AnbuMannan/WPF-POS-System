<UserControl x:Class="POS.UI.Modules.Inventory.StockTake.PhysicalStockTakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.UI.Modules.Inventory.StockTake"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="{StaticResource BrushWindowBg}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER BAR: SCAN AREA ============ -->
        <Border Grid.Row="0" Background="{StaticResource BrushSidebarBg}" CornerRadius="8,8,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Physical Stock Take" 
                               Foreground="{StaticResource BrushTextWhite}" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Inventory Audit Terminal" 
                               Foreground="{StaticResource BrushTextTertiary}" 
                               FontSize="12"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="18" Foreground="{StaticResource BrushTextTertiary}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>

                            <TextBox x:Name="TxtBarcode" Grid.Column="1"
                                     Text="{Binding SearchBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40" FontSize="16" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="5,0,10,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Grid.Column="1" Text="Scan Barcode or SKU..." 
                                       FontSize="16" Foreground="{StaticResource BrushTextTertiary}" 
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding Text, ElementName=TxtBarcode, Converter={StaticResource StringEmptyToVisibility}}"/>
                        </Grid>
                    </Border>
                </Grid>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#30FFFFFF" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Items Scanned: " Foreground="{StaticResource BrushTextWhite}" FontSize="13"/>
                            <TextBlock Text="{Binding TotalScannedItems}" Foreground="{StaticResource BrushTextWhite}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ MAIN CONTENT: AUDIT GRID ============ -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderThickness="1,0,1,1" BorderBrush="{StaticResource BrushBorderSoft}">
            <DataGrid ItemsSource="{Binding AuditItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="45">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Barcode / SKU" Binding="{Binding Barcode}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="System Qty" Binding="{Binding SystemQty, StringFormat=N2}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,15,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Physical Qty" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E6F7FF" Margin="4" CornerRadius="4" BorderBrush="#91D5FF" BorderThickness="1">
                                    <TextBox Text="{Binding PhysicalQty, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             FontWeight="Bold"
                                             FontSize="15"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             Foreground="{StaticResource BrushTextPrimary}"
                                             BorderThickness="0"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Variance Qty" Binding="{Binding VarianceQty, StringFormat=N2}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,15,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{Binding VarianceQty, Converter={StaticResource VarianceColorConverter}}"/>
                                <Setter Property="ToolTip" Value="Total difference between System and Physical quantities"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Variance Amount" Binding="{Binding VarianceAmount, Converter={StaticResource DecimalToCurrency}}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,15,0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{Binding VarianceAmount, Converter={StaticResource VarianceColorConverter}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ FOOTER: TOTALS & ACTIONS ============ -->
        <Border Grid.Row="2" Background="{StaticResource BrushSidebarBg}" CornerRadius="0,0,8,8">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Total Variance Value" Foreground="{StaticResource BrushTextTertiary}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalVarianceAmount, Converter={StaticResource DecimalToCurrency}}" 
                               Foreground="{StaticResource BrushTextWhite}" 
                               FontSize="28" 
                               FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="Complete Audit" 
                        Command="{Binding CompleteAuditCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Height="50"
                        MinWidth="200"
                        FontSize="16">
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
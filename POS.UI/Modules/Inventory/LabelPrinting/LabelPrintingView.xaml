<UserControl x:Class="POS.UI.Modules.Inventory.LabelPrinting.LabelPrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:POS.UI.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Focusable="True"
             Loaded="LabelPrintingView_Loaded"
             PreviewKeyDown="LabelPrintingView_KeyDown">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding PrintLabelsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= SHORTCUTS BAR ================= -->
        <Border Grid.Row="0" 
                Background="#263238" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,10"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F1" FontWeight="Bold"/> Search Product
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F2" FontWeight="Bold"/> Print
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F5" FontWeight="Bold"/> Refresh
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="DEL" FontWeight="Bold"/> Remove Item
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= MODE 1: MANUAL PRODUCT SEARCH ================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6" 
                Padding="15" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Product Search -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔍 Mode 1: Search Product (Manual)" FontWeight="SemiBold" FontSize="12" Foreground="#424242" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBox x:Name="ProductSearchBox"
                                 Height="36"
                                 FontSize="13"
                                 Padding="10,0"
                                 Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Type product name, SKU or barcode to add..." 
                                                                       Foreground="Gray" 
                                                                       FontSize="12"
                                                                       Margin="10,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Product Search Popup -->
                        <Popup PlacementTarget="{Binding ElementName=ProductSearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               IsOpen="{Binding IsProductSearchPopupOpen, Mode=TwoWay}">
                            <Border Background="White" 
                                    BorderBrush="#DEE2E6" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    MinWidth="400">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <ListBox ItemsSource="{Binding FilteredProducts}"
                                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                         MaxHeight="300"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="SKU: " FontSize="11" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding SKU}" FontSize="11" Foreground="Gray"/>
                                                        <TextBlock Text=" | Barcode: " FontSize="11" Foreground="Gray" Margin="5,0,0,0"/>
                                                        <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="Gray"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding SellingPrice, StringFormat='₹{0:N2}'}" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2" 
                                                           VerticalAlignment="Center"
                                                           Margin="15,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Add Button -->
                <Button Grid.Column="1"
                        Content="+ Add"
                        Width="80"
                        Height="36"
                        Margin="15,23,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddItemCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ================= MODE 2: IMPORT FROM PURCHASE ENTRY ================= -->
        <Border Grid.Row="2" 
                Background="#E3F2FD" 
                BorderBrush="#90CAF9"
                BorderThickness="1"
                CornerRadius="6" 
                Padding="15" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Purchase Entry Selection -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📦 Mode 2: Import from Purchase Entry (GRN)" FontWeight="SemiBold" FontSize="12" Foreground="#1565C0" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding PurchaseEntries}"
                              SelectedItem="{Binding SelectedPurchaseEntry, Mode=TwoWay}"
                              Height="36"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding InvoiceNo}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text=" - " Foreground="Gray" Margin="3,0"/>
                                    <TextBlock Text="{Binding SupplierName}" Foreground="#616161" FontSize="11"/>
                                    <TextBlock Text=" | " Foreground="Gray" Margin="3,0"/>
                                    <TextBlock Text="{Binding ReceivedDate, StringFormat='dd-MM-yyyy'}" Foreground="#1976D2" FontSize="11"/>
                                    <TextBlock Text=" | " Foreground="Gray" Margin="3,0"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Import Button -->
                <Button Grid.Column="1"
                        Content="📥 Import Items"
                        Width="120"
                        Height="36"
                        Margin="15,23,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Bottom"
                        Command="{Binding ImportFromEntryCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ================= LABEL ITEMS GRID ================= -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="12" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="🏷️ Labels to Print" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   DockPanel.Dock="Left"/>
                        <Button Content="🗑️ Clear All"
                                Width="90"
                                Height="26"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Command="{Binding ClearAllCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFCDD2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🗑️ Remove"
                                Width="80"
                                Height="26"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Margin="0,0,10,0"
                                Command="{Binding RemoveItemCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFE0B2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LabelItems}"
                          SelectedItem="{Binding SelectedLabelItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="40"
                          FontSize="12"
                          SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#263238"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#1E272E"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              TextBlock.Foreground="White"
                                                              TextBlock.FontWeight="Bold"
                                                              TextBlock.FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Product Name -->
                        <DataGridTextColumn Header="Product Name" 
                                            Binding="{Binding ProductName}" 
                                            Width="*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SKU -->
                        <DataGridTextColumn Header="SKU" 
                                            Binding="{Binding SKU}" 
                                            Width="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#616161"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Barcode -->
                        <DataGridTextColumn Header="Barcode" 
                                            Binding="{Binding Barcode}" 
                                            Width="140"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Price -->
                        <DataGridTextColumn Header="Price" 
                                            Binding="{Binding SellingPrice, StringFormat='₹{0:N2}'}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,12,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- MRP -->
                        <DataGridTextColumn Header="MRP" 
                                            Binding="{Binding MRP, StringFormat='₹{0:N2}'}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,12,0"/>
                                    <Setter Property="Foreground" Value="#757575"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Print Count (Editable) -->
                        <DataGridTextColumn Header="Print Count" 
                                            Binding="{Binding PrintCount, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!-- Empty State -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LabelItems.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="White">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                                        <TextBlock Text="🏷️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                                        <TextBlock Text="No labels to print"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#999999"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock Text="Search and add products above, or import from a Purchase Entry"
                                                                   FontSize="13"
                                                                   Foreground="#AAAAAA"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= PRINT SUMMARY ================= -->
        <Border Grid.Row="4" 
                Background="#1B5E20" 
                CornerRadius="4" 
                Padding="15,10" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Items: " Foreground="#A5D6A7" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LabelItems.Count}" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="Total Labels: " Foreground="#A5D6A7" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLabelCount}" Foreground="White" FontWeight="Bold" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress Bar (shown during printing) -->
                <ProgressBar Grid.Column="0" 
                             Value="{Binding PrintProgress}" 
                             Height="8" 
                             Margin="0,30,200,0"
                             Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="#2E7D32"
                             Foreground="#A5D6A7"/>

                <Button Grid.Column="1"
                        x:Name="PrintButton"
                        Content="🖨️ Print Labels (F2)"
                        Width="160"
                        Height="40"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="PrintButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#66BB6A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#43A047"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#81C784"/>
                                                <Setter Property="Foreground" Value="#C8E6C9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="5" 
                Background="#F5F5F5" 
                CornerRadius="4" 
                Padding="12,8" 
                Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="#616161"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <Button Content="🔄 Refresh (F5)"
                        Width="110"
                        Height="28"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="#424242"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

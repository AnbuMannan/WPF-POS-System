<UserControl x:Class="POS.UI.Modules.Inventory.StockAdjustment.CreateStockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Focusable="True"
             KeyDown="UserControl_KeyDown">
    
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= SHORTCUTS BAR ================= -->
        <Border Grid.Row="0" 
                Background="#263238" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,10"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F1" FontWeight="Bold"/> Search
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F2" FontWeight="Bold"/> Save
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="TAB" FontWeight="Bold"/> Navigate
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="ESC" FontWeight="Bold"/> Cancel/Back
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= COMPACT HEADER SECTION ================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6" 
                Padding="12" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Date -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Adjustment Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding AdjustmentDate, Mode=TwoWay}"
                                Height="28"
                                FontSize="12"
                                TabIndex="1"
                                Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 2: Reason -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reason *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding Reasons}"
                              SelectedItem="{Binding SelectedReason, Mode=TwoWay}"
                              Height="28"
                              FontSize="12"
                              TabIndex="2"
                              Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 3: Remarks -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Remarks" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,0"
                             TabIndex="3"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= HELP TEXT ================= -->
        <Border Grid.Row="2" 
                Background="#FFF8E1" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding ReasonHelpText}" 
                       Foreground="#F57C00" 
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- ================= PRODUCT SEARCH SECTION ================= -->
        <Border Grid.Row="3" 
                Background="#F8F9FA" 
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="4" 
                Padding="10" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Product Search Section -->
                <TextBlock Grid.Column="0"
                           Text="🔍 Search Products:" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="#424242"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Height="32"
                         TabIndex="4"
                         FontSize="12"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="ProductSearchBox">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Type product name, SKU or barcode..." 
                                                               Foreground="Gray" 
                                                               FontSize="11"
                                                               Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Product Search Results Popup -->
                <Popup PlacementTarget="{Binding ElementName=ProductSearchBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       Width="400"
                       IsOpen="{Binding IsProductSearchPopupOpen, Mode=TwoWay}">
                    <Border Background="White" 
                            BorderBrush="#DEE2E6" 
                            BorderThickness="1" 
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                        </Border.Effect>
                        <ListBox ItemsSource="{Binding FilteredProducts}"
                                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                 MaxHeight="250"
                                 BorderThickness="0"
                                 x:Name="ProductListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SKU: " FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding SKU}" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text=" | " FontSize="10" Foreground="Gray" Margin="5,0"/>
                                            <TextBlock Text="{Binding CostPrice, StringFormat='₹{0:N2}'}" FontSize="10" Foreground="#2196F3" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Padding" Value="4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#BBDEFB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Popup>

                <Button Grid.Column="2"
                        Content="➕ Add"
                        Width="80"
                        Height="32"
                        Margin="10,0,0,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Cursor="Hand"
                        Command="{Binding AddItemCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ================= ITEMS SECTION ================= -->
        <Border Grid.Row="4" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact Items Toolbar -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="8" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="Adjustment Items (TAB to navigate)" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   DockPanel.Dock="Left"/>

                        <Button Content="🗑 Remove"
                                Width="80"
                                Height="26"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RemoveSelectedItemCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Items DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="36"
                          FontSize="12"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Margin="0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#263238"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#1E272E"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="38"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              TextBlock.Foreground="White"
                                                              TextBlock.FontWeight="Bold"
                                                              TextBlock.FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <!-- Product Name -->
                        <DataGridTextColumn Header="Product *" 
                                            Binding="{Binding ProductName}" 
                                            Width="*"
                                            MinWidth="200"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SKU -->
                        <DataGridTextColumn Header="SKU" 
                                            Binding="{Binding ProductSku}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Current Stock -->
                        <DataGridTextColumn Header="Current Stock" 
                                            Binding="{Binding CurrentStock, StringFormat='N2'}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Quantity to Adjust -->
                        <DataGridTextColumn Header="Qty to Adjust *" 
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Cost Price -->
                        <DataGridTextColumn Header="Cost Price" 
                                            Binding="{Binding CostPrice, StringFormat='₹{0:N2}'}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total Value -->
                        <DataGridTextColumn Header="Total Value" 
                                            Binding="{Binding TotalValue, StringFormat='₹{0:N2}', Mode=OneWay}" 
                                            Width="110"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Validation Error -->
                        <DataGridTextColumn Header="Error" 
                                            Binding="{Binding ValidationError}" 
                                            Width="150"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Remove Button -->
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Foreground="#F44336"
                                            BorderThickness="0"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            ToolTip="Remove this item"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <!-- Empty State -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="White">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                                        <TextBlock Text="No items added yet"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF999999"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock FontSize="13" Foreground="#FFAAAAAA" HorizontalAlignment="Center">
                                                            <Run Text="Search and add products above to adjust stock"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= COMPACT TOTALS SECTION ================= -->
        <Border Grid.Row="5" 
                Background="#1B5E20" 
                CornerRadius="4" 
                Padding="12,8" 
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Use TAB for quick navigation" 
                               FontSize="11" 
                               Foreground="White"
                               Opacity="0.9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Validation Error -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationError}"
                           Foreground="#FFCDD2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Items: " 
                               Foreground="White" 
                               FontSize="13" 
                               Opacity="0.9" 
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalItems}" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL VALUE: " 
                               Foreground="#A5D6A7" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalValue, StringFormat='₹{0:N2}'}" 
                               Foreground="#FFFFFF" 
                               FontSize="24" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= COMPACT ACTIONS ================= -->
        <Border Grid.Row="6" 
                Background="White" 
                Padding="10" 
                CornerRadius="4" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Save Adjustment (F2)"
                        Width="180"
                        Height="36"
                        Margin="0,0,10,0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✖ Cancel (Esc)"
                        Width="140"
                        Height="36"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#424242"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="#BDBDBD">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ================= LOADING OVERLAY ================= -->
        <Border Grid.Row="0" Grid.RowSpan="7"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Processing..." FontSize="16" Foreground="#666"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

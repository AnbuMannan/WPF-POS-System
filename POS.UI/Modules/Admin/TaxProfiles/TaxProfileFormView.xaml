<Window x:Class="POS.UI.Modules.Admin.TaxProfiles.TaxProfileFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tax Profile"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tax Profile"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="NameBox"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Foreground="Red" FontSize="11" Margin="4,2,0,8"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameBox}"
                           Visibility="{Binding (Validation.HasError), ElementName=NameBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="CGST %" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding CGST, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <TextBlock Text="SGST %" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding SGST, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <TextBlock Text="IGST %" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding IGST, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <TextBlock Text="Cess %" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding Cess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <TextBlock Text="Is Active" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="6" Grid.Column="1" Content="" IsChecked="{Binding IsActiveChecked, Mode=TwoWay}" />

            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />
            <Button Content="Reset" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetCommand}" />
            <Button Content="Cancel" Width="90"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>

    </Grid>
</Window>

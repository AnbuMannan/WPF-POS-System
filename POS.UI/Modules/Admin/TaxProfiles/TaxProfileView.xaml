<UserControl x:Class="POS.UI.Modules.Admin.TaxProfiles.TaxProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR ================= -->
        <Border Grid.Row="0" Padding="8" CornerRadius="6" Background="#FFF5F5F5">
            <DockPanel LastChildFill="True">

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox Width="260"
                             Height="32"
                             Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Clear"
                            Width="60"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearCommand}" />

                    <Button Content="Search"
                            Width="90"
                            Margin="0,0,12,0"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding SearchCommand}" />

                    <CheckBox Content="Show Inactive"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowInactive, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Width="90"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" />

                    <Button Content="Add"
                            Width="100"
                            Margin="0,0,6,0"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding AddCommand}" />

                    <Button Content="Edit"
                            Width="80"
                            Margin="0,0,6,0"
                            Style="{StaticResource WarningButtonStyle}"
                            Command="{Binding EditCommand}" />

                    <Button Content="Disable"
                            Width="90"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DisableCommand}" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= TAX PROFILE LIST GRID ================= -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding TaxProfiles}"
                      SelectedItem="{Binding SelectedTaxProfile}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="CGST %" Width="*" Binding="{Binding CGST, StringFormat=N2}" />
                    <DataGridTextColumn Header="SGST %" Width="*" Binding="{Binding SGST, StringFormat=N2}" />
                    <DataGridTextColumn Header="IGST %" Width="*" Binding="{Binding IGST, StringFormat=N2}" />
                    <DataGridTextColumn Header="Cess %" Width="*" Binding="{Binding Cess, StringFormat=N2}" />
                    <DataGridCheckBoxColumn Header="Active" Width="*" Binding="{Binding IsActive}" />
                    <DataGridTextColumn Header="Created" Width="*" Binding="{Binding CreatedAt, StringFormat=dd-MM-yyyy}" />
                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>
</UserControl>

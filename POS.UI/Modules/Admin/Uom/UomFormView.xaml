<Window x:Class="POS.UI.Modules.Admin.Uom.UomFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit of Measurement (UoM)"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Unit of Measurement (UoM)"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding UomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Red" FontSize="11" Margin="4,2,0,8"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameBox}"
                           Visibility="{Binding (Validation.HasError), ElementName=NameBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="Code" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CodeBox"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="Red" FontSize="11" Margin="4,2,0,8"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CodeBox}"
                           Visibility="{Binding (Validation.HasError), ElementName=CodeBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="Symbol" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         MaxLength="16"
                         Text="{Binding Symbol, Mode=TwoWay}" />

                <TextBlock Text="Decimal Places" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="DecimalPlacesBox"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding DecimalPlacesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Description" Grid.Row="6" Grid.Column="0" VerticalAlignment="Top"/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Style="{StaticResource FormTextBox}"
                         Height="60" AcceptsReturn="True"
                         Text="{Binding Description, Mode=TwoWay}" />

                <TextBlock Text="Is Active" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="7" Grid.Column="1"
                          IsChecked="{Binding IsActiveChecked, Mode=TwoWay}" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />
            <Button Content="Reset" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetCommand}" />
            <Button Content="Cancel" Width="90"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>

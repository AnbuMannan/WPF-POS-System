<Window x:Class="POS.UI.Modules.Admin.Brands.BrandFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brand"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <TextBlock Text="Brand"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- ========== FORM BODY ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Brand Name" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="BrandNameBox"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding BrandName,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Foreground="Red"
                       FontSize="11"
                       Margin="4,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=BrandNameBox}"
                       Visibility="{Binding (Validation.HasError), ElementName=BrandNameBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="Code" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding Code}" />

            <TextBlock Text="Description" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Height="80"
                     AcceptsReturn="True"
                     Text="{Binding Description}" />
            
            <TextBlock Text="Is Active" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="4" Grid.Column="1"
                      Content=""
                      IsChecked="{Binding IsActiveChecked, Mode=TwoWay}" />
            
            </Grid>
        </ScrollViewer>

        <!-- ========== FOOTER BUTTONS ========== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Save"
                    Width="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />

            <Button Content="Reset"
                    Width="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetCommand}" />

            <Button Content="Cancel"
                    Width="90"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>

    </Grid>
</Window>

<Window x:Class="POS.UI.Modules.Admin.Products.ProductFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POS.UI.Core.Helpers"
        Title="Product"
        Width="1000"
        MinHeight="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <!-- Columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Rows -->
            <Grid.RowDefinitions>
                <!-- Each row tall enough for textbox + error line -->
                <RowDefinition Height="60"/>
                <!-- Product Name / SKU -->
                <RowDefinition Height="60"/>
                <!-- Barcode / Unit -->
                <RowDefinition Height="60"/>
                <!-- Category / Brand -->
                <RowDefinition Height="60"/>
                <!-- Tax / HSN -->
                <RowDefinition Height="60"/>
                <!-- Cost / Selling -->
                <RowDefinition Height="60"/>
                <!-- MRP -->
                <RowDefinition Height="Auto"/>
                <!-- Flags -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>


            <!-- ================= PRODUCT NAME ================= -->

            <TextBlock Text="Product Name" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>

            <TextBox Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource FormTextBoxWithValidation}"
                     Text="{Binding ProductName,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <!-- ================= SKU ================= -->

            <TextBlock Text="SKU" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBox Grid.Row="0" Grid.Column="4"
                     Style="{StaticResource FormTextBoxWithValidation}"
                     Text="{Binding SKU,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <!-- ================= BARCODE ================= -->

            <TextBlock Text="Barcode" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>

            <TextBox Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource FormTextBoxWithValidation}"
                     Text="{Binding Barcode,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <!-- ================= UNIT ================= -->

            <TextBlock Text="Unit" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBox Grid.Row="1" Grid.Column="4"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding Unit}" />

            <!-- ================= CATEGORY ================= -->

            <TextBlock Text="Category" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>

            <ComboBox Grid.Row="2" Grid.Column="1"
                      Style="{StaticResource FormComboBoxWithValidation}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      DisplayMemberPath="Name" />


            <!-- ================= BRAND ================= -->

            <TextBlock Text="Brand" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"/>

            <ComboBox Grid.Row="2" Grid.Column="4"
                      Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding Brands}"
                      SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                      DisplayMemberPath="Name" />


            <!-- ================= TAX PROFILE ================= -->

            <TextBlock Text="Tax Profile" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>

            <ComboBox Grid.Row="3" Grid.Column="1"
                      Style="{StaticResource FormComboBoxWithValidation}"
                      ItemsSource="{Binding TaxProfiles}"
                      SelectedItem="{Binding SelectedTaxProfile, Mode=TwoWay}"
                      DisplayMemberPath="Name" />


            <!-- ================= HSN ================= -->

            <TextBlock Text="HSN Code" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBox Grid.Row="3" Grid.Column="4"
                     Style="{StaticResource FormTextBoxWithValidation}"
                     Text="{Binding HSNCode,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <!-- ================= COST / SELLING ================= -->

            <TextBlock Text="Cost Price" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>

            <TextBox Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding CostPrice}" />

            <TextBlock Text="Selling Price" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBox Grid.Row="4" Grid.Column="4"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding SellingPrice}" />

            <!-- ================= MRP ================= -->

            <TextBlock Text="MRP" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>

            <TextBox Grid.Row="5" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding MRP}" />

            <!-- ================= FLAGS ================= -->

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5"
                        Orientation="Horizontal" Margin="0,20,0,0">
                <CheckBox Content="Weighable" IsChecked="{Binding IsWeighable, Mode=TwoWay}" Margin="0,0,20,0"/>
                <CheckBox Content="Manufactured" IsChecked="{Binding IsManufactured, Mode=TwoWay}" Margin="0,0,20,0"/>
                <CheckBox Content="Tax Inclusive" IsChecked="{Binding IsTaxInclusive, Mode=TwoWay}" Margin="0,0,20,0"/>
                <CheckBox Content="Active" IsChecked="{Binding IsProductActive, Mode=TwoWay}"/>
            </StackPanel>

            <!-- ================= BUTTONS ================= -->

            <Border Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Margin="0,40,0,0"
                    BorderThickness="1,0,0,0"
                    BorderBrush="#DDD">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Save"
                            Width="120"
                            Height="40"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}" />

                    <Button Content="Reset"
                            Width="120"
                            Height="40"
                            Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetCommand}" />
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>

</Window>

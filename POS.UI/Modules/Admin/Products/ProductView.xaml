<UserControl x:Class="POS.UI.Modules.Admin.Products.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:POS.UI.Modules.Admin.Products"
             xmlns:conv="clr-namespace:POS.UI.Core.Converters"
             mc:Ignorable="d">



    <UserControl.Resources>
        <conv:SearchMatchConverter x:Key="SearchMatchConverter"/>
    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOOLBAR (same theme as Brand/Category) ================= -->
        <Border Grid.Row="0" Padding="8" CornerRadius="6" Background="#FFF5F5F5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="Add"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource WarningButtonStyle}"/>
                
                <!-- 🔥 NEW DISABLE BUTTON -->
                <Button Content="Disable"
                        Command="{Binding DisableCommand}"
                        Style="{StaticResource DangerButtonStyle}"/>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <TextBox Width="240"
                         Margin="10,10,0,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource WatermarkTextBox}"
                         Tag="Search Name / SKU / Barcode"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                
                <Button Content="Clear"
                    Width="60"
                    Margin="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
                
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource SuccessButtonStyle}"/>

                <CheckBox Content="Show Inactive"
                          Margin="10,10,0,0"
                          IsChecked="{Binding ShowInactive}" />

            </StackPanel>
        </Border>

        <!-- ================= DATA GRID (same border/theme as Brand/Category) ================= -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1">
        <DataGrid ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  FrozenColumnCount="3">

            <DataGrid.Columns>

                <!-- Core -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="120"/>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="140"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>

                <!-- Pricing -->
                
                <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="MRP" Binding="{Binding MRP}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Compliance -->
                <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="100"/>
                <DataGridTextColumn Header="TaxProfile Id" Binding="{Binding TaxProfileId}" Width="90"/>

                <!-- Classification -->
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140"/>
                <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="120"/>

                <!-- Flags -->
                <DataGridCheckBoxColumn Header="Weighable" Binding="{Binding IsWeighable}" Width="90"/>
                <DataGridCheckBoxColumn Header="Mfg" Binding="{Binding IsManufactured}" Width="70"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>

            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                    <Style.Triggers>
                        <!-- Highlight matched rows (search) -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource SearchMatchConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.SearchText" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#FFFFF3B0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <!-- Highlight zero price (Product only) -->
                        <DataTrigger Binding="{Binding SellingPrice}" Value="0">
                            <Setter Property="Background" Value="#FFF3E0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>
        </Border>

    </Grid>
</UserControl>

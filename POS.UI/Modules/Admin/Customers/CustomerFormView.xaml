<Window x:Class="POS.UI.Modules.Admin.Customers.CustomerFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <TextBlock Text="Customer"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- ========== FORM BODY ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="First Name" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="FirstNameBox"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding FirstName,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Foreground="Red"
                       FontSize="11"
                       Margin="4,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=FirstNameBox}"
                       Visibility="{Binding (Validation.HasError), ElementName=FirstNameBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="Last Name" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="LastNameBox"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding LastName,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Foreground="Red"
                       FontSize="11"
                       Margin="4,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=LastNameBox}"
                       Visibility="{Binding (Validation.HasError), ElementName=LastNameBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="Phone" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     x:Name="PhoneBox"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding Phone,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Grid.Row="5" Grid.Column="1"
                       Foreground="Red"
                       FontSize="11"
                       Margin="4,2,0,8"
                       Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PhoneBox}"
                       Visibility="{Binding (Validation.HasError), ElementName=PhoneBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="Email" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding Email}" />

            <TextBlock Text="Address" Grid.Row="7" Grid.Column="0" VerticalAlignment="Top"/>
            <TextBox Grid.Row="7" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Height="60"
                     AcceptsReturn="True"
                     Text="{Binding Address}" />

            <TextBlock Text="Date of Birth" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="8" Grid.Column="1"
                       SelectedDate="{Binding DateOfBirth}" />

            <TextBlock Text="Loyalty Number" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="9" Grid.Column="1"
                     Style="{StaticResource FormTextBox}"
                     Text="{Binding LoyaltyNumber}" />

            <TextBlock Text="Is Wholesale" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="10" Grid.Column="1"
                      Content=""
                      IsChecked="{Binding IsWholesale, Mode=TwoWay}" />

            <TextBlock Text="Is Active" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="11" Grid.Column="1"
                      Content=""
                      IsChecked="{Binding IsActive, Mode=TwoWay}" />
            
            </Grid>
        </ScrollViewer>

        <!-- ========== FOOTER BUTTONS ========== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Save"
                    Width="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />

            <Button Content="Cancel"
                    Width="90"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>

    </Grid>
</Window>

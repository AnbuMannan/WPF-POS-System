<UserControl x:Class="POS.UI.Modules.Suppliers.SupplierLedger.SupplierLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             KeyDown="UserControl_KeyDown"
             Focusable="True">

    <UserControl.Resources>
        <!-- Amount Styles -->
        <Style x:Key="DebitAmountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="CreditAmountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BalanceAmountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="QuickDateButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <!-- Filter Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== FILTER PANEL ==================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Supplier & Date Selection -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <!-- Supplier Dropdown -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Width="300"
                                  Height="36"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" (" Foreground="#888"/>
                                        <TextBlock Text="{Binding Code}" Foreground="#888"/>
                                        <TextBlock Text=")" Foreground="#888"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="From Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FromDate}"
                                    Width="140"
                                    Height="36"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="To Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ToDate}"
                                    Width="140"
                                    Height="36"/>
                    </StackPanel>

                    <!-- Show Ledger Button -->
                    <StackPanel Margin="0,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text=" " Style="{StaticResource LabelStyle}"/>
                        <Button Content="Show Ledger (F5)"
                                Width="140"
                                Height="36"
                                Style="{StaticResource SuccessButtonStyle}"
                                Command="{Binding ShowLedgerCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Print (Ctrl+P)"
                            Width="110"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PrintPdfCommand}"/>
                    <Button Content="Export (Ctrl+E)"
                            Width="110"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportExcelCommand}"/>
                    <Button Content="Clear (Esc)"
                            Width="90"
                            Height="36"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding ClearCommand}"/>
                </StackPanel>

                <!-- Row 2: Quick Date Presets -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Quick:" VerticalAlignment="Center" Margin="0,0,8,0" 
                               FontSize="11" Foreground="#888"/>
                    <Button Content="This Month" Style="{StaticResource QuickDateButtonStyle}" 
                            Command="{Binding ThisMonthCommand}"/>
                    <Button Content="Last Month" Style="{StaticResource QuickDateButtonStyle}" 
                            Command="{Binding LastMonthCommand}"/>
                    <Button Content="This FY" Style="{StaticResource QuickDateButtonStyle}" 
                            Command="{Binding ThisYearCommand}"/>
                    <Button Content="Last 30 Days" Style="{StaticResource QuickDateButtonStyle}" 
                            Command="{Binding Last30DaysCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== SUMMARY CARDS ==================== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="10,10,10,0"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Opening Balance -->
                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Opening Balance" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding OpeningBalanceText}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                    </StackPanel>
                </Border>

                <!-- Total Debit (Payments/Returns - reduce balance) -->
                <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Debit (Paid)" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding TotalDebitText}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Border>

                <!-- Total Credit (Purchases - increase balance) -->
                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Credit (Owed)" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding TotalCreditText}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>

                <!-- Closing Balance -->
                <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Closing Balance" FontSize="11" Foreground="#888"/>
                        <TextBlock Text="{Binding ClosingBalanceText}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== LEDGER DATA GRID ==================== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Ledger Entries for " FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SupplierInfoText}" FontSize="14" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Text=" | " FontSize="14" Foreground="#CCC" Margin="8,0"/>
                    <TextBlock Text="{Binding DateRangeText}" FontSize="14" Foreground="#666"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LedgerEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="#E0E0E0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="36">
                    
                    <DataGrid.Columns>
                        <!-- Date -->
                        <DataGridTextColumn Header="Date" Width="100"
                                            Binding="{Binding Date, StringFormat='dd-MMM-yyyy'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Transaction Type -->
                        <DataGridTextColumn Header="Type" Width="100"
                                            Binding="{Binding TransactionType}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="Description" Width="*"
                                            Binding="{Binding Description}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Reference No -->
                        <DataGridTextColumn Header="Reference No" Width="130"
                                            Binding="{Binding ReferenceNo}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Debit Amount (Green - money paid to supplier) -->
                        <DataGridTextColumn Header="Debit (₹)" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="DebitAmount" StringFormat="N2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DebitAmount}" Value="0">
                                            <Setter Property="Foreground" Value="#CCC"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Credit Amount (Red - money owed to supplier) -->
                        <DataGridTextColumn Header="Credit (₹)" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="CreditAmount" StringFormat="N2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CreditAmount}" Value="0">
                                            <Setter Property="Foreground" Value="#CCC"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Running Balance -->
                        <DataGridTextColumn Header="Balance (₹)" Width="120">
                            <DataGridTextColumn.Binding>
                                <Binding Path="RunningBalance" StringFormat="N2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#333"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#888"
                           Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibility}}">
                    <Run Text="Select a supplier and date range, then click "/>
                    <Run Text="'Show Ledger'" FontWeight="Bold"/>
                    <Run Text=" to view transactions"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="#666"
                           VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" 
                           FontSize="11" 
                           Foreground="#888"
                           VerticalAlignment="Center">
                    <Run Text="Shortcuts: "/>
                    <Run Text="F5" FontWeight="Bold"/>
                    <Run Text=" Show | "/>
                    <Run Text="Ctrl+P" FontWeight="Bold"/>
                    <Run Text=" Print | "/>
                    <Run Text="Ctrl+E" FontWeight="Bold"/>
                    <Run Text=" Export | "/>
                    <Run Text="Esc" FontWeight="Bold"/>
                    <Run Text=" Clear"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading ledger..." FontSize="18" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

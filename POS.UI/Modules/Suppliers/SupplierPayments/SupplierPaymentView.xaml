<UserControl x:Class="POS.UI.Modules.Suppliers.SupplierPayments.SupplierPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             KeyDown="UserControl_KeyDown"
             Focusable="True">

    <UserControl.Resources>
        <!-- Balance Display Styles -->
        <Style x:Key="BalanceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <!-- Left Panel: Supplier List with Balances -->
            <ColumnDefinition Width="400"/>
            <!-- Right Panel: Payment Form + Details -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL: SUPPLIER LIST ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Suppliers" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Select a supplier to make payment" 
                               FontSize="12" Foreground="#888888"/>
                </StackPanel>

                <!-- Search Box -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Height="36"
                             Padding="10,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search suppliers..."/>
                    
                    <Button Grid.Column="1"
                            Content="↻"
                            Width="36"
                            Height="36"
                            Margin="8,0,0,0"
                            ToolTip="Refresh (F5)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <!-- Supplier List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SupplierBalances}"
                         SelectedItem="{Binding SelectedSupplier}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,6" 
                                    Background="#FAFAFA" CornerRadius="6"
                                    BorderBrush="#E8E8E8" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Supplier Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding SupplierName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>

                                    <!-- Balance -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding CurrentBalance, StringFormat='₹ {0:N2}'}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#D32F2F"/>

                                    <!-- Supplier Code & Mobile -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SupplierCode}"
                                                   FontSize="11" Foreground="#888888"/>
                                        <TextBlock Text=" | " FontSize="11" Foreground="#CCCCCC"/>
                                        <TextBlock Text="{Binding Mobile}"
                                                   FontSize="11" Foreground="#888888"/>
                                    </StackPanel>

                                    <!-- Last Transaction -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Margin="0,4,0,0"
                                               FontSize="10" Foreground="#AAAAAA">
                                        <Run Text="Last: "/>
                                        <Run Text="{Binding LastTransactionDate, StringFormat='dd-MMM-yyyy', TargetNullValue='No transactions'}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== RIGHT PANEL: PAYMENT FORM & DETAILS ==================== -->
        <Grid Grid.Column="1" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <!-- Balance Display -->
                <RowDefinition Height="Auto"/>
                <!-- Payment Form -->
                <RowDefinition Height="Auto"/>
                <!-- Recent Payments / Ledger Tabs -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Selected Supplier Balance Display -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Selected Supplier" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding SelectedSupplier.SupplierName, FallbackValue='No supplier selected'}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedSupplier.SupplierCode, FallbackValue=''}"
                                   FontSize="12" Foreground="#888888"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Outstanding Balance" Style="{StaticResource LabelStyle}" 
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SelectedSupplierBalance}"
                                   Style="{StaticResource BalanceTextStyle}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Payment Form -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10"
                    IsEnabled="{Binding IsSupplierSelected}">
                <StackPanel>
                    <TextBlock Text="Payment Entry" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1: Date, Payment Mode, Amount -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Payment Date" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding PaymentDate}"
                                        Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Payment Mode" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PaymentModes}"
                                      SelectedItem="{Binding SelectedPaymentMode}"
                                      Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Amount (₹)" Style="{StaticResource FormLabelStyle}"/>
                                <Button Grid.Column="1" Content="Pay Full" 
                                        FontSize="10" Padding="6,2"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding PayFullBalanceCommand}"
                                        ToolTip="Fill outstanding balance"/>
                            </Grid>
                            <TextBox x:Name="AmountTextBox"
                                     Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                     Height="36"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     HorizontalContentAlignment="Right"/>
                        </StackPanel>

                        <!-- Row 2: Bank Name, Reference No (shown conditionally) -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"
                                    Visibility="{Binding ShowBankFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Bank Name" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"
                                    Visibility="{Binding ShowBankFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reference/Cheque No." Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"/>
                        </StackPanel>

                        <!-- Row 2/3: Remarks (full width when bank fields hidden) -->
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                            <TextBlock Text="Remarks" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"/>
                        </StackPanel>

                        <!-- Row 3: Action Buttons -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0">
                            
                            <Button Content="Clear (Esc)"
                                    Width="100"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFormCommand}"/>

                            <Button Content="Save Payment (F2)"
                                    Width="150"
                                    Height="36"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Command="{Binding SavePaymentCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent Payments & Ledger -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Recent Payments Tab -->
                    <TabItem Header="Recent Payments">
                        <DataGrid ItemsSource="{Binding RecentPayments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  BorderThickness="0"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment No" Width="120"
                                                    Binding="{Binding PaymentNo}"/>
                                <DataGridTextColumn Header="Date" Width="100"
                                                    Binding="{Binding PaymentDate, StringFormat='dd-MMM-yyyy'}"/>
                                <DataGridTextColumn Header="Mode" Width="100"
                                                    Binding="{Binding PaymentMode}"/>
                                <DataGridTextColumn Header="Amount" Width="120">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Amount" StringFormat="₹ {0:N2}"/>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Reference" Width="120"
                                                    Binding="{Binding ReferenceNo}"/>
                                <DataGridTextColumn Header="Remarks" Width="*"
                                                    Binding="{Binding Remarks}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Ledger Tab -->
                    <TabItem Header="Supplier Ledger">
                        <DataGrid ItemsSource="{Binding SupplierLedger}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  BorderThickness="0"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="100"
                                                    Binding="{Binding TransactionDate, StringFormat='dd-MMM-yyyy'}"/>
                                <DataGridTextColumn Header="Type" Width="100"
                                                    Binding="{Binding TransactionType}"/>
                                <DataGridTextColumn Header="Reference" Width="120"
                                                    Binding="{Binding ReferenceNo}"/>
                                <DataGridTextColumn Header="Description" Width="*"
                                                    Binding="{Binding Description}"/>
                                <DataGridTextColumn Header="Debit" Width="100">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="DebitAmount" StringFormat="₹ {0:N2}"/>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Credit" Width="100">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="CreditAmount" StringFormat="₹ {0:N2}"/>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Balance" Width="100">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Balance" StringFormat="₹ {0:N2}"/>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading..." FontSize="18" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="POS.UI.Modules.Suppliers.PurchaseEntry.CreatePurchaseEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Focusable="True">
    
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= SHORTCUTS BAR ONLY ================= -->
        <Border Grid.Row="0" 
                Background="#263238" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,10"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F1" FontWeight="Bold"/> Search
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F2" FontWeight="Bold"/> Save
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="TAB" FontWeight="Bold"/> Navigate
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="ESC" FontWeight="Bold"/> Cancel
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= COMPACT HEADER SECTION ================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6" 
                Padding="12" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Supplier & Invoice No -->
                <StackPanel Grid.Column="0">
                    <!-- Supplier -->
                    <TextBlock Text="Supplier *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedValue="{Binding SupplierId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              Height="28"
                              FontSize="12"
                              TabIndex="1"
                              Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text=" (" Foreground="Gray" Margin="3,0,0,0"/>
                                    <TextBlock Text="{Binding Code}" Foreground="Gray"/>
                                    <TextBlock Text=")" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Invoice No -->
                    <TextBlock Text="Invoice No *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding InvoiceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,0"
                             TabIndex="2"
                             Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 2: Dates -->
                <StackPanel Grid.Column="2">
                    <!-- Invoice Date -->
                    <TextBlock Text="Invoice Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                                Height="28"
                                FontSize="12"
                                TabIndex="3"
                                Margin="0,0,0,8"/>

                    <!-- Received Date -->
                    <TextBlock Text="Received Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding ReceivedDate, Mode=TwoWay}"
                                Height="28"
                                FontSize="12"
                                TabIndex="4"
                                Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 3: PO Ref & Notes -->
                <StackPanel Grid.Column="4">
                    <!-- PO Reference -->
                    <TextBlock Text="PO Reference" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PurchaseOrderId, Mode=OneWay}"
                             IsReadOnly="True"
                             Height="28"
                             FontSize="11"
                             Padding="6,0"
                             Background="#F5F5F5"
                             Margin="0,0,0,8"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             FontSize="12"
                             Padding="6"
                             TabIndex="5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= COMPACT QUICK IMPORT & PRODUCT SEARCH (SINGLE LINE) ================= -->
        <Border Grid.Row="2" 
                Background="#F8F9FA" 
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="4" 
                Padding="10" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Quick Import Section -->
                <TextBlock Grid.Column="0"
                           Text="📦 Quick Import:" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="#1976D2"
                           Margin="0,0,8,0"/>
                
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding PendingPurchaseOrders}"
                          SelectedItem="{Binding SelectedPurchaseOrder, Mode=TwoWay}"
                          Height="28"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PO: " FontSize="10" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReferenceNo}" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text=" - " Foreground="Gray" Margin="2,0" FontSize="10"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Foreground="#1976D2" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <Button Grid.Column="2"
                        Content="Import"
                        Width="70"
                        Height="28"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="11"
                        Cursor="Hand"
                        Command="{Binding ImportFromPOCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Separator -->
                <Separator Grid.Column="3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>

                <!-- Product Search Section -->
                <TextBlock Grid.Column="4"
                           Text="🔍 Search Products:" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="#424242"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="5"
                         Height="28"
                         TabIndex="6"
                         FontSize="11"
                         Padding="6,0"
                         Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="ProductSearchBox">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search products (F1)..." 
                                                               Foreground="Gray" 
                                                               FontSize="11"
                                                               Margin="5,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Product Search Results Popup -->
                <Popup PlacementTarget="{Binding ElementName=ProductSearchBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       Width="280"
                       IsOpen="{Binding IsProductSearchPopupOpen, Mode=TwoWay}">
                    <Border Background="White" 
                            BorderBrush="#DEE2E6" 
                            BorderThickness="1" 
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                        </Border.Effect>
                        <ListBox ItemsSource="{Binding ProductSearchResults}"
                                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                 MaxHeight="200"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SKU: " FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding SKU}" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text=" | " FontSize="10" Foreground="Gray" Margin="3,0"/>
                                            <TextBlock Text="{Binding CostPrice, StringFormat='₹{0:N2}'}" FontSize="10" Foreground="#2196F3" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ================= ITEMS SECTION ================= -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact Items Toolbar -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="8" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="Items (TAB to navigate)" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   DockPanel.Dock="Left"/>

                        <Button Content="Remove"
                                Width="80"
                                Height="26"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RemoveItemCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Items DataGrid - RAPID ENTRY with TAB NAVIGATION -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="32"
                          FontSize="12"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          Margin="0">

                    <DataGrid.Columns>

                        <!-- Product Name (Read-only) -->
                        <DataGridTextColumn Header="Product *" 
                                            Binding="{Binding ProductName}" 
                                            Width="200"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Batch No (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="Batch No" 
                                            Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="120"/>

                        <!-- Expiry Date (Editable - TAB HERE) -->
                        <DataGridTemplateColumn Header="Expiry Date" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                BorderThickness="0"
                                                Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantity (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="Quantity *" 
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cost Price (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="Cost Price *" 
                                            Binding="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Selling Price (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="Selling Price *" 
                                            Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- MRP (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="MRP *" 
                                            Binding="{Binding MRP, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tax Amount (Editable - TAB HERE) -->
                        <DataGridTextColumn Header="Tax" 
                                            Binding="{Binding TaxAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total (Calculated, Read-only) -->
                        <DataGridTextColumn Header="Total" 
                                            Binding="{Binding Total, StringFormat='₹{0:N2}', Mode=OneWay}" 
                                            Width="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                    <!-- Empty State -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="White">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                                        <TextBlock Text="No items added yet"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF999999"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock FontSize="13" Foreground="#FFAAAAAA" HorizontalAlignment="Center">
                                                            <Run Text="Option 1: Search and add products above"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="13" Foreground="#FFAAAAAA" HorizontalAlignment="Center">
                                                            <Run Text="Option 2: Import from a Purchase Order (blue section)"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= COMPACT TOTALS SECTION ================= -->
        <Border Grid.Row="4" 
                Background="#1B5E20" 
                CornerRadius="4" 
                Padding="12,8" 
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Use TAB for quick navigation" 
                               FontSize="11" 
                               Foreground="White"
                               Opacity="0.9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Tax: " 
                               Foreground="White" 
                               FontSize="13" 
                               Opacity="0.9" 
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TaxAmount, StringFormat='₹{0:N2}'}" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " 
                               Foreground="#A5D6A7" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" 
                               Foreground="#FFFFFF" 
                               FontSize="24" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= COMPACT ACTIONS ================= -->
        <Border Grid.Row="5" 
                Background="White" 
                Padding="10" 
                CornerRadius="4" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Save (F2)"
                        Width="140"
                        Height="36"
                        Margin="0,0,10,0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✖ Cancel (Esc)"
                        Width="140"
                        Height="36"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#424242"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="#BDBDBD">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

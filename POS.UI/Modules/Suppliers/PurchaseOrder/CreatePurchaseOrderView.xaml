<UserControl x:Class="POS.UI.Modules.Suppliers.PurchaseOrder.CreatePurchaseOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="F1" Command="{Binding FocusProductSearchCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= SHORTCUTS BAR ================= -->
        <Border Grid.Row="0" 
                Background="#263238" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,12"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F2" FontWeight="Bold"/> Save
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="ESC" FontWeight="Bold"/> Cancel
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F1" FontWeight="Bold"/> Search Products
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= HEADER SECTION ================= -->
        <Border Grid.Row="1" 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Supplier & Order Date -->
                <StackPanel Grid.Column="0">
                    <!-- Supplier -->
                    <TextBlock Text="Supplier *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              Height="28"
                              FontSize="12"
                              TabIndex="1"
                              Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                    <TextBlock Text=" (" Foreground="Gray" FontSize="11" Margin="2,0,0,0"/>
                                    <TextBlock Text="{Binding Code}" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text=")" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Order Date -->
                    <TextBlock Text="Order Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                Height="28"
                                FontSize="12"
                                TabIndex="2"
                                Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 2: Delivery Date & Status -->
                <StackPanel Grid.Column="2">
                    <!-- Expected Delivery Date -->
                    <TextBlock Text="Expected Delivery Date" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, Mode=TwoWay}"
                                Height="28"
                                FontSize="12"
                                TabIndex="3"
                                Margin="0,0,0,8"/>

                    <!-- Order Status -->
                    <TextBlock Text="Order Status" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Status, Mode=OneWay}"
                             IsReadOnly="True"
                             Height="28"
                             FontSize="11"
                             Padding="6,0"
                             Background="#F5F5F5"
                             Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Column 3: Reference No & Notes -->
                <StackPanel Grid.Column="4">
                    <!-- Reference No -->
                    <TextBlock Text="Reference No" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding ReferenceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,0"
                             TabIndex="4"
                             Margin="0,0,0,8"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             FontSize="12"
                             Padding="6"
                             TabIndex="5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ITEMS SECTION ================= -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Items Toolbar -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="8" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="Items (F1 to search, TAB to navigate)" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    DockPanel.Dock="Right">
                            
                            <!-- Product Search -->
                            <TextBox Width="280"
                                     Height="26"
                                     Margin="0,0,8,0"
                                     TabIndex="6"
                                     FontSize="12"
                                     Padding="6,0"
                                     Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     x:Name="ProductSearchBox"
                                     PreviewKeyDown="ProductSearchBox_PreviewKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="🔍 Search products to add..." 
                                                                           Foreground="Gray" 
                                                                           FontSize="11"
                                                                           Margin="5,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Product Search Results Popup -->
                            <Popup PlacementTarget="{Binding ElementName=ProductSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   Width="280"
                                   IsOpen="{Binding IsProductSearchPopupOpen, Mode=TwoWay}"
                                   x:Name="ProductSearchPopup">
                                <Border Background="White" 
                                        BorderBrush="#DEE2E6" 
                                        BorderThickness="1" 
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ListBox ItemsSource="{Binding ProductSearchResults}"
                                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                             MaxHeight="200"
                                             BorderThickness="0"
                                             x:Name="ProductSearchListBox"
                                             PreviewKeyDown="ProductSearchListBox_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="SKU: " FontSize="10" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding SKU}" FontSize="10" Foreground="Gray"/>
                                                        <TextBlock Text=" | " FontSize="10" Foreground="Gray" Margin="3,0"/>
                                                        <TextBlock Text="{Binding CostPrice, StringFormat='₹{0:N2}'}" FontSize="10" Foreground="#2196F3" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <Button Content="Remove"
                                    Width="80"
                                    Height="26"
                                    FontSize="11"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding RemoveItemCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Items DataGrid - RAPID ENTRY with TAB NAVIGATION -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="32"
                          FontSize="12"
                          Margin="0">

                    <DataGrid.Columns>

                        <!-- Product Name -->
                        <DataGridTextColumn Header="Product" 
                                            Binding="{Binding ProductName}" 
                                            Width="*" 
                                            MinWidth="200"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SKU -->
                        <DataGridTextColumn Header="SKU" 
                                            Binding="{Binding ProductSKU}" 
                                            Width="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Quantity -->
                        <DataGridTextColumn Header="Quantity" 
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Unit Price -->
                        <DataGridTextColumn Header="Unit Price" 
                                            Binding="{Binding UnitPrice, StringFormat='₹{0:N2}', UpdateSourceTrigger=PropertyChanged}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tax Amount -->
                        <DataGridTextColumn Header="Tax" 
                                            Binding="{Binding TaxAmount, StringFormat='₹{0:N2}', UpdateSourceTrigger=PropertyChanged}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total -->
                        <DataGridTextColumn Header="Total" 
                                            Binding="{Binding Total, StringFormat='₹{0:N2}', Mode=OneWay}" 
                                            Width="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                    <!-- Empty State -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="White">
                                                    <TextBlock Text="No items added. Search and add products above."
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Foreground="#999999"
                                                               Margin="0,50,0,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= TOTALS & ACTIONS SECTION ================= -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Totals -->
            <Border Grid.Column="0"
                    Background="#F8F9FA" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6" 
                    Padding="15,12"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Amount:" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center" 
                               Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#2196F3" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="💾 Save"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TabIndex="7"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save (F2)"/>
                <Button Content="❌ Cancel"
                        Width="120"
                        Height="40"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TabIndex="8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Cancel (ESC)"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

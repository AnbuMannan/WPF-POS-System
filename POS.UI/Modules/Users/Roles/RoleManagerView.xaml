<UserControl x:Class="POS.UI.Modules.Users.Roles.RoleManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL - ROLES LIST ================= -->
        <Border Grid.Column="0" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1"
                Background="#FFF5F5F5" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Roles" FontSize="16" FontWeight="Bold" 
                           Foreground="#333" Margin="12,12,12,8"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" 
                         SelectedItem="{Binding SelectedRole}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="Add Role"
                        Margin="12"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding AddRoleCommand}" />
            </Grid>
        </Border>

        <!-- ================= RIGHT PANEL - PERMISSIONS ================= -->
        <Border Grid.Column="1" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1"
                Background="#FFF5F5F5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
                    <TextBlock Text="Permissions for: " FontSize="16" Foreground="#333"/>
                    <TextBlock Text="{Binding SelectedRole.Name}" FontSize="16" FontWeight="Bold" Foreground="#0078D7"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0">
                    <ItemsControl ItemsSource="{Binding PermissionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Margin="0,0,0,10" Padding="14"
                                        BorderBrush="#EEEEEE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Module}" FontSize="14" FontWeight="Bold" 
                                                   Foreground="#0078D7" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Permissions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAssigned}" Margin="0,3">
                                                        <CheckBox.Content>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Description}" Foreground="#333" FontSize="13"/>
                                                                <TextBlock Text="{Binding Code, StringFormat=' ({0})'}" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox.Content>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                    <Button Content="Refresh"
                            Width="90"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Save Permissions"
                            Width="130"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SavePermissionsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..." Foreground="#333" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

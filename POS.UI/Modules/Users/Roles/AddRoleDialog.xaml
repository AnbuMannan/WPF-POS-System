<Window x:Class="POS.UI.Modules.Users.Roles.AddRoleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Role" 
        Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add New Role" FontSize="18" FontWeight="Bold" 
                   Foreground="#333" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Role Name *" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="RoleNameBox" 
                     Style="{StaticResource DialogTextBox}"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="DescriptionBox" 
                     Style="{StaticResource DialogTextBox}"
                     Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="8,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" 
                    Width="90"
                    Margin="0,0,6,0"
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Click="Cancel_Click"/>
            <Button Content="Create Role" 
                    Width="110"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>

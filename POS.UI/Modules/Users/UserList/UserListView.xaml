<UserControl x:Class="POS.UI.Modules.Users.UserList.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR ================= -->
        <Border Grid.Row="0" Padding="8" CornerRadius="6" Background="#FFF5F5F5">
            <DockPanel LastChildFill="True">

                <!-- Left : Search -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox Width="300"
                             Height="32"
                             Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Show Inactive"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowInactive, Mode=TwoWay}" />

                    <Button Content="Refresh"
                            Width="90"
                            Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- Right : Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Add User"
                            Width="100"
                            Margin="0,0,6,0"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding AddCommand}" />

                    <Button Content="Edit"
                            Width="80"
                            Margin="0,0,6,0"
                            Style="{StaticResource WarningButtonStyle}"
                            Command="{Binding EditCommand}" />

                    <Button Content="Reset Password"
                            Width="120"
                            Margin="0,0,6,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ResetPasswordCommand}" />

                    <Button Content="Disable"
                            Width="90"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DisableCommand}" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= USER LIST GRID ================= -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username"
                                        Width="1.5*"
                                        Binding="{Binding Username}" />

                    <DataGridTextColumn Header="Full Name"
                                        Width="2*"
                                        Binding="{Binding FullName}" />

                    <DataGridTextColumn Header="Email"
                                        Width="2*"
                                        Binding="{Binding Email}" />

                    <DataGridTextColumn Header="Role"
                                        Width="1.5*"
                                        Binding="{Binding RoleName}" />

                    <DataGridCheckBoxColumn Header="Active"
                                             Width="*"
                                             Binding="{Binding IsActive}" />

                    <DataGridTextColumn Header="Last Login"
                                        Width="1.5*"
                                        Binding="{Binding LastLogin, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" />

                    <DataGridTextColumn Header="Created"
                                        Width="*"
                                        Binding="{Binding CreatedAt, StringFormat=dd-MM-yyyy}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..." Foreground="#333" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

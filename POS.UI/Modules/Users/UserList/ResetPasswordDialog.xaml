<Window x:Class="POS.UI.Modules.Users.UserList.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" 
        Height="260" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16">
            <Run Text="Reset password for: "/>
            <Run Text="{Binding Username, Mode=OneWay}" Foreground="#0078D7"/>
        </TextBlock>

        <StackPanel Grid.Row="1">
            <TextBlock Text="New Password" Foreground="#555" FontSize="13" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox" 
                         Height="34" FontSize="14" Padding="8,6"
                         BorderBrush="#CCCCCC" BorderThickness="1"
                         Margin="0,0,0,14"/>

            <TextBlock Text="Confirm Password" Foreground="#555" FontSize="13" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" 
                         Height="34" FontSize="14" Padding="8,6"
                         BorderBrush="#CCCCCC" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" 
                    Width="90"
                    Margin="0,0,6,0"
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Click="Cancel_Click"/>
            <Button Content="Reset Password" 
                    Width="120"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>

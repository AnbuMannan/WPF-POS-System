<UserControl x:Class="POS.UI.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BrushWindowBg}">
    <UserControl.Resources>
        <Style x:Key="StatCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.25" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource FontIcon}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="RowHeight" Value="35" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding WelcomeText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextSecondary}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource IconButton}"
                    Margin="0,0,4,0"
                    Foreground="{StaticResource BrushTextSecondary}"
                    ToolTip="Refresh"
                    Command="{Binding RefreshCommand}">
                <TextBlock Text="&#xE72C;"
                           FontFamily="{StaticResource FontIcon}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sales Today"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TodaySalesAmountDisplay}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="12,0,0,0"
                            CornerRadius="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#34D399" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE80D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Transactions"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TodayTransactionCountDisplay}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="12,0,0,0"
                            CornerRadius="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorPrimary}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE14C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Low Stock"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding LowStockItemCountDisplay}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="12,0,0,0"
                            CornerRadius="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorAccentRed}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCardBorder}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pending POs"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding PendingOrdersCountDisplay}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="12,0,0,0"
                            CornerRadius="20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorAccentOrange}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE7BF;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Recent Sales"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <DataGrid ItemsSource="{Binding RecentSales}"
                              Margin="0"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              Style="{StaticResource DefaultDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill #"
                                                Binding="{Binding BillNumber}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding CreatedAt, StringFormat=dd-MMM-yyyy HH:mm}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding TotalAmount, StringFormat=N2}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,2"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF3E0" />
                                                    <Setter Property="BorderBrush" Value="#FFE0B2" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#E6F4EA" />
                                                            <Setter Property="BorderBrush" Value="#E6F4EA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#C25E00" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="#1E8E3E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No recent sales to display"
                               FontSize="14"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="4" IsIndeterminate="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Loading dashboard..."
                               Foreground="{StaticResource BrushTextWhite}"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


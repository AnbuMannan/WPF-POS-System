<UserControl x:Class="POS.UI.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sales Today -->
            <Border Grid.Column="0" CornerRadius="10" Margin="0,0,8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4CAF50" Offset="0"/>
                        <GradientStop Color="#FF2E7D32" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sales Today" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding TodaySalesAmountDisplay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="&#xEB0F;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#80FFFFFF"
                               FontSize="32"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Transactions -->
            <Border Grid.Column="1" CornerRadius="10" Margin="8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF42A5F5" Offset="0"/>
                        <GradientStop Color="#FF1E88E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Transactions" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding TodayTransactionCountDisplay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="&#xE14C;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#80FFFFFF"
                               FontSize="32"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Low Stock -->
            <Border Grid.Column="2" CornerRadius="10" Margin="8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFEF5350" Offset="0"/>
                        <GradientStop Color="#FFE53935" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Low Stock" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding LowStockItemCountDisplay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#80FFFFFF"
                               FontSize="32"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Pending POs -->
            <Border Grid.Column="3" CornerRadius="10" Margin="8,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFB74D" Offset="0"/>
                        <GradientStop Color="#FFF57C00" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pending POs" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding PendingOrdersCountDisplay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="&#xE7BF;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#80FFFFFF"
                               FontSize="32"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Recent Sales -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Recent Sales" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Refresh"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Command="{Binding RefreshCommand}"/>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding RecentSales}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bill #" Binding="{Binding BillNumber}" Width="120"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd-MMM-yyyy HH:mm}" Width="180"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>


<UserControl x:Class="POS.UI.Modules.Reports.EODReport.EODReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BrushWindowBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- Toolbar: Date + Generate -->
            <Border Padding="12" CornerRadius="6" Background="{StaticResource BrushCardBg}" Margin="0,0,0,12"
                    BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Report Date" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding ReportDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="Generate Report" Width="140" Height="36"
                                Style="{StaticResource SuccessButtonStyle}"
                                Command="{Binding GenerateReportCommand}"/>
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Loading…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,0,0,8" Foreground="{StaticResource BrushTextSecondary}"/>

            <!-- Placeholder when no report -->
            <Border BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,12"
                    Visibility="{Binding Report, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="Select a date and click Generate Report to view Day End summary."
                           FontSize="14" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center"/>
            </Border>

            <!-- Report content -->
            <Border BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1" CornerRadius="6" Padding="20"
                    Visibility="{Binding Report, Converter={StaticResource NotNullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Day End Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Summary cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Sales" FontSize="12" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding TotalSalesCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#0D47A1"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="6" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Total Revenue" FontSize="12" Foreground="#2E7D32"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#1B5E20">
                                    <TextBlock.Text>
                                        <Binding Path="TotalRevenue" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Total Discounts" FontSize="12" Foreground="#E65100"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#BF360C">
                                    <TextBlock.Text>
                                        <Binding Path="TotalDiscountsGiven" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Payment breakdown (list as bars) -->
                    <GroupBox Header="Payment breakdown" Padding="8" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding PaymentBreakdownList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Method}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountFormatted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- Tax collected -->
                    <GroupBox Header="Tax collected" Padding="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="CGST" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="TotalCGST" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="SGST" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="TotalSGST" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="IGST" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="TotalIGST" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Discounts & Returns -->
                    <GroupBox Header="Discounts &amp; Returns" Padding="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Returns count" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding TotalReturnsCount, Mode=OneWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total refunds" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="TotalRefunds" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Cash reconciliation -->
                    <GroupBox Header="Cash reconciliation" Padding="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Opening cash" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="8,0,0,0" Padding="8,6"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0">
                                <Run Text="Cash sales: "/>
                                <Run>
                                    <Run.Text>
                                        <Binding Path="CashSalesAmount" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                            <TextBlock Grid.Row="2">
                                <Run Text="Cash refunds: "/>
                                <Run>
                                    <Run.Text>
                                        <Binding Path="CashRefundAmount" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,5"> 
                                <TextBlock Text="Petty Cash/Expenses: " Foreground="{DynamicResource BrushDanger}" /> 
                                <TextBlock Text="{Binding TotalExpenses, StringFormat='- ₹ {0:N2}'}" Foreground="{DynamicResource BrushDanger}" /> 
                            </StackPanel> 
                            <TextBlock Grid.Row="4" FontWeight="Bold" FontSize="14" Margin="0,4,0,0">
                                <Run Text="Expected closing cash: "/>
                                <Run>
                                    <Run.Text>
                                        <Binding Path="ExpectedCash" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                            <Grid Grid.Row="5" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Actual cash" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding ActualCash, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="8,0,0,0" Padding="8,6"/>
                            </Grid>
                            <Border Grid.Row="6" Margin="0,8,0,0" Padding="8" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashShortage, Mode=OneWay}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCashOverage, Mode=OneWay}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="Difference: "/>
                                    <Run>
                                        <Run.Text>
                                            <Binding Path="CashDifference" Mode="OneWay" StringFormat="₹ {0:N2}"/>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Top Sales / Top Products (optional, compact) -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Top sales" Padding="8" Margin="0,0,4,0">
                            <ListBox ItemsSource="{Binding TopSales}" MaxHeight="120" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding BillNumber}" FontWeight="SemiBold" Width="100"/>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <Binding Path="TotalAmount" StringFormat="₹ {0:N2}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Top selling products" Padding="8" Margin="4,0,0,0">
                            <ListBox ItemsSource="{Binding TopSellingProducts}" MaxHeight="120" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Width="120" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding QuantitySold, StringFormat=N0}" Margin="8,0,0,0"/>
                                            <TextBlock Margin="4,0,0,0">
                                                <TextBlock.Text>
                                                    <Binding Path="Revenue" StringFormat="₹ {0:N2}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>

                    <!-- Action buttons -->
                    <Border BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Print Report" Width="120" Height="36" Margin="0,0,8,0"
                                    Command="{Binding PrintReportCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Print to PDF" Width="120" Height="36" Margin="0,0,8,0"
                                    Command="{Binding PrintToPdfCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="Close Day" Width="120" Height="36" Margin="0,0,8,0"
                                    Command="{Binding CloseDayCommand}" Style="{StaticResource WarningButtonStyle}"/>
                            <Button Content="Export to Excel" Width="130" Height="36"
                                    Command="{Binding ExportToExcelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

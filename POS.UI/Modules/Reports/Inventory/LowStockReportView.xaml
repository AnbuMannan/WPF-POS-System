<UserControl x:Class="POS.UI.Modules.Reports.Inventory.LowStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushWindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,12"
                Background="{StaticResource BrushCardBg}"
                CornerRadius="6"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Reorder Threshold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="80"
                         Style="{StaticResource FormTextBox}"
                         Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Load"
                        Command="{Binding LoadCommand}"
                        Margin="12,0,0,0"
                        Width="100"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="{Binding TotalItems, StringFormat='Items: {0}'}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BrushCardBg}"
                CornerRadius="6"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product"
                                        Binding="{Binding ProductName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding SKU}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Available Stock"
                                        Binding="{Binding AvailableStock, StringFormat={}{0:N2}}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Reorder Level"
                                        Binding="{Binding ReorderLevel, StringFormat={}{0:N2}}"
                                        Width="150"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Ledger"
                                            Padding="6,2"
                                            Margin="0,0,5,0"
                                            Click="LedgerButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="POS.UI.Modules.Reports.Finance.ProfitLossReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushWindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,12"
                Background="{StaticResource BrushCardBg}"
                CornerRadius="6"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="From" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                <Button Content="Generate"
                        Command="{Binding GenerateCommand}"
                        Margin="20,0,0,0"
                        Width="120"
                        Height="36"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Content="Export"
                        Command="{Binding ExportCommand}"
                        Margin="10,0,0,0"
                        Width="100"
                        Height="36"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="Print"
                        Command="{Binding PrintCommand}"
                        Margin="10,0,0,0"
                        Width="100"
                        Height="36"
                        Style="{StaticResource SecondaryButton}"/>
                <TextBlock Text="{Binding PeriodText}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Margin="0,0,12,0"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource BrushCardBg}">
                <StackPanel>
                    <TextBlock Text="Summary" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Sales"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalSales, StringFormat='₹ {0:N2}'}"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cost of Goods Sold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalCogs, StringFormat='₹ {0:N2}'}"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Expenses"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalExpenses, StringFormat='₹ {0:N2}'}"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <Separator Margin="0,5,0,5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding IsProfit, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Net Profit|Net Loss'}"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProfitLoss, StringFormat='₹ {0:N2}'}"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                            <Setter Property="Foreground" Value="DarkRed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource BrushCardBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Overview" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,0,2"/>
                                    <Grid Height="20">
                                        <Border Background="#E0E0E0" CornerRadius="3"/>
                                        <Border Background="#4CAF50"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource SegmentWidthConverter}">
                                                    <Binding Path="Amount"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="DataContext.MaxSegmentAmount"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                        <TextBlock Text="{Binding Amount, StringFormat='₹ {0:N2}'}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

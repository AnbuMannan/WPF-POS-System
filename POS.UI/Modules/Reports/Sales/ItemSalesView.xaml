<UserControl x:Class="POS.UI.Modules.Reports.Sales.ItemSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:POS.UI.Modules.Reports.Sales"
             Background="{StaticResource BrushWindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushCardBg}"
                Padding="12"
                CornerRadius="6"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Item-wise Sales"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:ReportFilterControl/>
                    <StackPanel Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Button Content="Export CSV"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="110"/>
                        <Button Content="Print"
                                Command="{Binding PrintCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="96"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BrushCardBg}"
                Margin="0,12,0,0"
                Padding="0"
                CornerRadius="6"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding ItemRows}"
                      AutoGenerateColumns="False"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}"/>
                    <DataGridTextColumn Header="Qty Sold" Binding="{Binding QuantitySold, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="POS.UI.Modules.Finance.Expenses.ExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="{StaticResource BrushWindowBg}" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Entry Card -->
        <Border Grid.Column="0"
                Background="{DynamicResource BrushSurface}"
                CornerRadius="8"
                Padding="20"
                Margin="10">
            <StackPanel>
                <TextBlock Text="New Expense"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <Separator Margin="0,8,0,12"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Date" Foreground="Gray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding NewExpense.ExpenseDate}"
                                Height="38"
                                Padding="10,0"
                                VerticalContentAlignment="Center"
                                BorderBrush="{DynamicResource BrushBorderSoft}"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Category" Foreground="Gray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding NewExpense.Category}"
                              Height="38"
                              Padding="10,0"
                              VerticalContentAlignment="Center"
                              BorderBrush="{DynamicResource BrushBorderSoft}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Description" Foreground="Gray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewExpense.Description, UpdateSourceTrigger=PropertyChanged}"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BrushBorderSoft}"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Amount" Foreground="Gray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewExpense.Amount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BrushBorderSoft}"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Created By" Foreground="Gray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewExpense.CreatedBy}"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BrushBorderSoft}"
                             HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Button Command="{Binding SaveExpenseCommand}"
                        HorizontalAlignment="Stretch"
                        Height="45"
                        FontSize="16"
                        Background="{DynamicResource BrushPrimary}"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,12,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE105;" FontFamily="{StaticResource FontIcon}" Margin="0,0,8,0"/>
                        <TextBlock Text="Save Expense"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right: Today's Expenses -->
        <Border Grid.Column="1"
                Background="{DynamicResource BrushSurface}"
                CornerRadius="8"
                Padding="20"
                Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Today's Expenses"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <Button Content="Refresh"
                            Command="{Binding LoadExpensesCommand}"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Expenses}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          Margin="0,8,0,8"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="40"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat=\{0:dd MMM yyyy HH:mm\}}" Width="140"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹ {0:N2}'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="100"/>
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource BrushDanger}"
                                            Content="🗑 Delete"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Background="{DynamicResource BrushPrimary}"
                        CornerRadius="0,0,8,8"
                        Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalExpenses, StringFormat='₹ {0:N2}'}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="POS.UI.Modules.Organization.Company.CompanyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <!-- Use a Grid as the outer container so the loading overlay stays fixed -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Company Profile" FontSize="20" FontWeight="Bold" 
                           Foreground="#333" Margin="0,0,0,16"/>

                <!-- Form -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= LEFT COLUMN ================= -->
                    <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="16" Margin="0,0,8,0"
                            BorderBrush="#FFE0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Basic Information" Style="{StaticResource SectionHeaderStyle}"/>

                            <TextBlock Text="Company Name *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}"
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="City" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="State" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Postal Code" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Country" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Tax Information" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,12"/>

                            <TextBlock Text="GST Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding GstNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="PAN Number" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding PanNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- ================= RIGHT COLUMN ================= -->
                    <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="16" Margin="8,0,0,0"
                            BorderBrush="#FFE0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Contact Information" Style="{StaticResource SectionHeaderStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Mobile" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Website" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Receipt Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Currency Symbol" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Currency Code" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Receipt Header" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Text="Receipt Footer" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <!-- Logo -->
                            <TextBlock Text="Company Logo" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="100" Height="100" Background="#FAFAFA" CornerRadius="6" 
                                        BorderBrush="#FFE0E0E0" BorderThickness="1">
                                    <Image Source="{Binding LogoUrl}" Stretch="Uniform" Margin="8"/>
                                </Border>
                                <Button Content="Upload Logo" 
                                        Command="{Binding UploadLogoCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,10">
                    <Button Content="Reload" 
                            Width="90"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" />
                    <Button Content="Save Profile" 
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay - OUTSIDE ScrollViewer so it stays fixed over the viewport -->
        <Border Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..." Foreground="#333" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

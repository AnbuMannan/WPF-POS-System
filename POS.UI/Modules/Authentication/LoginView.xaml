<Window x:Class="POS.UI.Modules.Authentication.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - POS System"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWindowBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <!-- ================== MAIN LAYOUT ================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT BRAND PANEL ================= -->
        <Border Grid.Column="0" Background="{StaticResource BrushPrimary}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Logo Placeholder -->
                <Ellipse Width="100"
                         Height="100"
                         Fill="{StaticResource BrushTextWhite}"
                         Opacity="0.9" />

                <!-- Brand Title -->
                <TextBlock Text="POS SYSTEM"
                           Foreground="{StaticResource BrushTextWhite}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,20,0,5"
                           HorizontalAlignment="Center" />

                <!-- Brand Subtitle -->
                <TextBlock Text="Retail Management Platform"
                           Foreground="{StaticResource BrushPrimaryLight}"
                           FontSize="14"
                           HorizontalAlignment="Center" />

                <!-- Version Info -->
                <TextBlock Text="v1.0.0"
                           Foreground="{StaticResource BrushTextWhite}"
                           FontSize="12"
                           Opacity="0.7"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ================= RIGHT LOGIN CARD ================= -->
        <Grid Grid.Column="1">
            <Border Width="380"
                    Background="{StaticResource BrushCardBg}"
                    CornerRadius="12"
                    Padding="30"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <!-- Drop Shadow Effect -->
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="3"
                                      Opacity="0.15"
                                      Color="#000000"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Welcome Title -->
                    <TextBlock Text="Welcome Back"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,5" />

                    <!-- Subtitle -->
                    <TextBlock Text="Please sign in to continue"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="13"
                               Margin="0,0,0,25" />

                    <!-- ================= USERNAME FIELD ================= -->
                    <TextBlock Text="Username"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="13"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding Username,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"
                             AutomationProperties.Name="Username" />

                    <!-- ================= PASSWORD FIELD ================= -->
                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="13"
                               Margin="0,0,0,6" />

                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Password" />

                    <!-- ================= STATUS MESSAGE ================= -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushAccentRed}"
                               FontSize="12"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"
                               MinHeight="20" />

                    <!-- ================= BUTTONS ================= -->

                    <!-- LOGIN BUTTON -->
                    <Button Content="Login"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,10"
                            Command="{Binding LoginCommand}"
                            AutomationProperties.Name="Login" />

                    <!-- CLEAR BUTTON -->
                    <Button Content="Clear"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCommand}"
                            AutomationProperties.Name="Clear" />

                    <!-- Server Status -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Click="OpenSystemHealth_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4"
                                ToolTip="View server status"
                                Foreground="{StaticResource BrushTextSecondary}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE9D9;"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Server Status" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ================= FOOTER ================= -->
                    <StackPanel Margin="0,20,0,0" Opacity="0.6">
                        <Separator BorderBrush="{StaticResource BrushBorderSoft}" Margin="0,0,0,8"/>
                        <TextBlock Text="2024 POSPro. All rights reserved."
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextAlignment="Center" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="POS.UI.Modules.Authentication.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.UI.Modules.Authentication"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid Background="{StaticResource BrushWindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Dark Branding -->
        <Border Grid.Column="0" Background="{StaticResource BrushPrimaryDark}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Viewbox Height="80" Margin="0,0,0,20">
                    <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Fill="White"/>
                </Viewbox>
                <TextBlock Text="MODERN POS" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Terminal Activation" FontSize="16" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right Side: Activation Form -->
        <Border Grid.Column="1" Padding="60,0">
            <StackPanel VerticalAlignment="Center" MaxWidth="450" HorizontalAlignment="Left">
                <TextBlock Text="Activate Terminal" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                <TextBlock Text="Enter your license key to register this physical terminal with your branch." FontSize="16" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,40"/>

                <TextBlock Text="License Key" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" 
                         Height="55" VerticalContentAlignment="Center" Padding="15,0" 
                         FontSize="18" FontWeight="Medium"
                         BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1.5">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Content="ACTIVATE TERMINAL" 
                        Command="{Binding ActivateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="60" Margin="0,30,0,0" FontSize="18" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,20,0,0" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{StaticResource BrushPrimary}"/>
                
                <TextBlock Text="{Binding StatusMessage}" Margin="0,15,0,0" 
                           HorizontalAlignment="Center" Foreground="{StaticResource BrushPrimary}"
                           FontWeight="Medium"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0">
                    <TextBlock Text="Need help?" Foreground="{StaticResource BrushTextTertiary}"/>
                    <TextBlock Text=" Contact Support" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" Cursor="Hand" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Server Status button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Click="OpenSystemHealth_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            ToolTip="View server status"
                            Foreground="{StaticResource BrushTextSecondary}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE9D9;"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Server Status" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

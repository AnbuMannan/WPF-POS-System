<UserControl x:Class="POS.UI.Modules.Sales.Quotations.QuotationEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding SearchProductCommand}"/>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= SHORTCUTS BAR ================= -->
        <Border Grid.Row="0" 
                Background="#263238" 
                CornerRadius="4" 
                Padding="10,6"
                Margin="0,0,0,10"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F1" FontWeight="Bold"/> Search Product
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="F2" FontWeight="Bold"/> Save
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="TAB" FontWeight="Bold"/> Navigate
                </TextBlock>
                <TextBlock Foreground="White" FontSize="10" Margin="5,0">
                    <Run Text="ESC" FontWeight="Bold"/> Cancel
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= COMPACT HEADER SECTION ================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6" 
                Padding="12" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Customer Info -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer Name" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,0"
                             TabIndex="1"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="Customer Phone" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,0"
                             TabIndex="2"/>
                </StackPanel>

                <!-- Column 2: Valid Until -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Valid Until" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <DatePicker SelectedDate="{Binding ValidUntil}"
                                Height="28"
                                FontSize="12"
                                TabIndex="3"/>
                </StackPanel>

                <!-- Column 3: Notes -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             FontSize="12"
                             Padding="6"
                             TabIndex="4"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= PRODUCT SEARCH BAR ================= -->
        <Border Grid.Row="2" 
                Background="#F8F9FA" 
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="4" 
                Padding="10" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔍 Search Products:" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="#424242"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Height="28"
                         TabIndex="5"
                         FontSize="11"
                         Padding="6,0"
                         Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="TxtProductSearch">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search products by name, SKU... (F1)" 
                                                               Foreground="Gray" 
                                                               FontSize="11"
                                                               Margin="5,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchProductCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Content="➕ Add Product (F1)"
                        Width="130"
                        Height="28"
                        Margin="8,0,0,0"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="11"
                        Cursor="Hand"
                        Command="{Binding SearchProductCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ================= ITEMS SECTION ================= -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Items Toolbar -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        Padding="8" 
                        BorderBrush="#DEE2E6" 
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="Quotation Items (TAB to navigate)" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   DockPanel.Dock="Left"/>
                        <Button Content="Remove"
                                Width="80"
                                Height="26"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RemoveItemCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Items DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="32"
                          FontSize="12"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          Margin="0">

                    <DataGrid.Columns>

                        <!-- Product Name -->
                        <DataGridTextColumn Header="Product" 
                                            Binding="{Binding ProductName}" 
                                            Width="*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SKU -->
                        <DataGridTextColumn Header="SKU" 
                                            Binding="{Binding SKU}" 
                                            Width="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- HSN -->
                        <DataGridTextColumn Header="HSN" 
                                            Binding="{Binding HSNCode}" 
                                            Width="80"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Unit -->
                        <DataGridTextColumn Header="Unit" 
                                            Binding="{Binding UnitName}" 
                                            Width="60"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Quantity -->
                        <DataGridTextColumn Header="Qty *" 
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Unit Price -->
                        <DataGridTextColumn Header="Price *" 
                                            Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Discount % -->
                        <DataGridTextColumn Header="Disc %" 
                                            Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Discount Amount -->
                        <DataGridTextColumn Header="Disc Amt" 
                                            Binding="{Binding DiscountAmount, StringFormat='N2'}" 
                                            Width="90"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tax % -->
                        <DataGridTextColumn Header="Tax %" 
                                            Binding="{Binding TaxRate}" 
                                            Width="60"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tax Amount -->
                        <DataGridTextColumn Header="Tax Amt" 
                                            Binding="{Binding TaxAmount, StringFormat='N2'}" 
                                            Width="90"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total -->
                        <DataGridTextColumn Header="Total" 
                                            Binding="{Binding TotalAmount, StringFormat='₹{0:N2}', Mode=OneWay}" 
                                            Width="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Background" Value="#FFF0F0F0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                    <!-- Empty State -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="White">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                                        <TextBlock Text="No items added yet"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF999999"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock FontSize="13" Foreground="#FFAAAAAA" HorizontalAlignment="Center">
                                                            <Run Text="Search and add products above (F1)"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================= TOTALS BAR (GREEN for Quotations) ================= -->
        <Border Grid.Row="4" 
                Background="#1B5E20" 
                CornerRadius="4" 
                Padding="12,8" 
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Use TAB for quick navigation" 
                               FontSize="11" 
                               Foreground="White"
                               Opacity="0.9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Tax: " 
                               Foreground="White" 
                               FontSize="13" 
                               Opacity="0.9" 
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TaxTotal, StringFormat='₹{0:N2}'}" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " 
                               Foreground="#A5D6A7" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" 
                               Foreground="#FFFFFF" 
                               FontSize="24" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ACTION BUTTONS ================= -->
        <Border Grid.Row="5" 
                Background="White" 
                Padding="10" 
                CornerRadius="4" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Save Quotation (F2)"
                        Width="180"
                        Height="36"
                        Margin="0,0,10,0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BDBDBD"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✖ Cancel (Esc)"
                        Width="140"
                        Height="36"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#424242"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="#BDBDBD">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

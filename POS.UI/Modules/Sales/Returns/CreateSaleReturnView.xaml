<UserControl x:Class="POS.UI.Modules.Sales.Returns.CreateSaleReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200"
             Focusable="True"
             Background="{StaticResource BrushWindowBg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F2"
                    Command="{Binding ProcessReturnCommand}"
                    CommandParameter="Cash"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER BAR: TITLE + INVOICE SEARCH ============ -->
        <Border Grid.Row="0" Background="{StaticResource BrushSidebarBg}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Sales Return"
                               Foreground="{StaticResource BrushTextWhite}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Search an invoice and select items to return"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="TxtInvoiceSearch"
                             Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             FontSize="13"
                             Padding="8,0"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left"
                                                             AlignmentY="Center"
                                                             Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Enter invoice number..."
                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                   FontSize="12"
                                                                   Margin="8,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchInvoiceCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Width="120"
                            Height="32"
                            Margin="8,0,0,0"
                            Command="{Binding SearchInvoiceCommand}"
                            Cursor="Hand"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource FontIcon}"
                                       FontSize="14"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Search Invoice"
                                       FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ MAIN CONTENT: LEFT TICKET + RIGHT GRID ============ -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ORIGINAL INVOICE "TICKET" -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Original Invoice"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <Border Background="{StaticResource BrushAccentGreen}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsInvoiceLoaded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Invoice.BillNumber}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextWhite}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Invoice.CustomerName, TargetNullValue=Walk-in}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="Date: "/>
                            <Run Text="{Binding Invoice.CreatedAt, StringFormat=dd MMM yyyy}"/>
                        </TextBlock>
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="Total Bill: "/>
                            <Run Text="{Binding Invoice.TotalAmount, Converter={StaticResource DecimalToCurrency}}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Return Mode"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding RefundModes}"
                                  SelectedItem="{Binding SelectedRefundMode}"
                                  Height="28"
                                  FontSize="12"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="Return Reason"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6"/>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource BrushCardBg}"
                            CornerRadius="4"
                            BorderBrush="{StaticResource BrushBorderSoft}"
                            BorderThickness="1">
                        <TextBlock Text="Select the items on the right and enter the quantity to return. Amounts update automatically."
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: RETURN ITEMS GRID -->
            <Border Grid.Column="1"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#263238"
                            Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Return Items"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Select All"
                                    Margin="0,4,0,4"
                                    Padding="10,4"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ReturnItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="12"
                              RowHeight="36"
                              AlternationCount="2"
                              Background="{StaticResource BrushCardBg}"
                              BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#263238"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#1E272E"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="45"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFFDE7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Item"
                                                Width="*"
                                                Binding="{Binding ProductName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0,4,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Sold"
                                                Width="70"
                                                Binding="{Binding OriginalQuantity}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Price"
                                                Width="90"
                                                Binding="{Binding SellingPrice, Converter={StaticResource DecimalToCurrency}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Return Qty" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="−"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Height="30"
                                                    Margin="0,4,4,4"
                                                    Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Background="#E3F2FD"
                                                    BorderBrush="#2196F3"
                                                    BorderThickness="1"
                                                    IsEnabled="{Binding IsSelected}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15"
                                                     FontWeight="SemiBold"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Height="30"
                                                     Margin="0,4,0,4"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     IsEnabled="{Binding IsSelected}"/>
                                            <Button Grid.Column="2"
                                                    Content="+"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Height="30"
                                                    Margin="4,4,0,4"
                                                    Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Background="#E3F2FD"
                                                    BorderBrush="#2196F3"
                                                    BorderThickness="1"
                                                    IsEnabled="{Binding IsSelected}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Refund Price"
                                                Width="110"
                                                Binding="{Binding RefundPrice, Converter={StaticResource DecimalToCurrency}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Amount"
                                                Width="120"
                                                IsReadOnly="True"
                                                Binding="{Binding ReturnAmount, Converter={StaticResource DecimalToCurrency}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="Padding" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Restock" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsRestockable, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Reason"
                                                Width="140"
                                                Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReturnItems.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGrid">
                                                    <Border Background="{StaticResource BrushCardBg}">
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,40,0,0">
                                                            <TextBlock Text="No items loaded"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Search for an invoice above to load returnable items"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ FOOTER: TOTAL REFUND + ACTIONS ============ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1,1,1,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="Total Refund"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalRefundAmount, Converter={StaticResource DecimalToCurrency}}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#D32F2F"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Width="170"
                            Height="36"
                            Margin="0,0,10,0"
                            Command="{Binding ProcessReturnCommand}"
                            CommandParameter="Cash"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsInvoiceLoaded, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEAFD;"
                                       FontFamily="{StaticResource FontIcon}"
                                       FontSize="16"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Refund Cash (F2)"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="170"
                            Height="36"
                            Margin="0,0,10,0"
                            Command="{Binding ProcessReturnCommand}"
                            CommandParameter="CreditNote"
                            Style="{StaticResource SuccessButtonStyle}"
                            Visibility="{Binding IsInvoiceLoaded, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="{StaticResource FontIcon}"
                                       FontSize="16"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Credit Note"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="120"
                            Height="36"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="{StaticResource FontIcon}"
                                       FontSize="14"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Cancel"
                                       FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ LOADING OVERLAY ============ -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="#66000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Border Background="White"
                        CornerRadius="6"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏳"
                                   FontSize="18"
                                   Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Processing sales return..."
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Please wait while we load or save data."
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

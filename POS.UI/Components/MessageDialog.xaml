<Window x:Class="POS.UI.Components.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="10"
            Background="{StaticResource BrushCardBg}"
            BorderBrush="{StaticResource BrushBorderSoft}"
            BorderThickness="1"
            Padding="16"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding IconGlyph}"
                       FontFamily="{StaticResource FontIcon}"
                       FontSize="22"
                       Foreground="{StaticResource BrushPrimary}"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding TitleText}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,10,0,0"
                       Text="{Binding MessageText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextPrimary}"/>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="{Binding SecondaryButtonText}"
                        Visibility="{Binding SecondaryVisibility}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="OnSecondaryClicked"/>
                <Button Content="{Binding PrimaryButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        Click="OnPrimaryClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

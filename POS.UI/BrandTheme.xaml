<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         UNIFIED BRAND THEME - ALL COLORS & STYLES CENTRALIZED
         ===================================================================== -->

    <!-- ================= COLOR PALETTE ================= -->
    <!-- Primary Colors -->
    <Color x:Key="ColorPrimary">#3F51B5</Color>
    <Color x:Key="ColorPrimaryDark">#303F9F</Color>
    <Color x:Key="ColorPrimaryLight">#C5CAE9</Color>

    <!-- Sidebar Colors -->
    <Color x:Key="ColorSidebarBg">#1F2430</Color>
    <Color x:Key="ColorSidebarHover">#2F3545</Color>
    <Color x:Key="ColorSidebarActive">#2A3245</Color>

    <!-- Semantic Colors -->
    <Color x:Key="ColorAccentGreen">#4CAF50</Color>
    <Color x:Key="ColorAccentRed">#F44336</Color>
    <Color x:Key="ColorAccentOrange">#FF9800</Color>

    <!-- Background Colors -->
    <Color x:Key="ColorWindowBg">#F4F6FA</Color>
    <Color x:Key="ColorCardBg">#FFFFFF</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#222222</Color>
    <Color x:Key="ColorTextSecondary">#666666</Color>
    <Color x:Key="ColorTextTertiary">#999999</Color>
    <Color x:Key="ColorTextWhite">#FFFFFF</Color>

    <!-- Border Colors -->
    <Color x:Key="ColorBorderSoft">#DDDDDD</Color>
    <Color x:Key="ColorBorderMedium">#CCCCCC</Color>
    <Color x:Key="ColorBorderDark">#999999</Color>

    <!-- ================= SOLID BRUSHES ================= -->
    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="{StaticResource ColorPrimaryDark}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />

    <!-- Sidebar Brushes -->
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}" />
    <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource ColorSidebarActive}" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorAccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource ColorAccentRed}" />
    <SolidColorBrush x:Key="BrushAccentOrange" Color="{StaticResource ColorAccentOrange}" />

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BrushWindowBg" Color="{StaticResource ColorWindowBg}" />
    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}" />

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BrushBorderSoft" Color="{StaticResource ColorBorderSoft}" />
    <SolidColorBrush x:Key="BrushBorderMedium" Color="{StaticResource ColorBorderMedium}" />
    <SolidColorBrush x:Key="BrushBorderDark" Color="{StaticResource ColorBorderDark}" />

    <!-- Legacy Compatibility (Maps to new colors) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ColorWindowBg}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorCardBg}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource ColorBorderSoft}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource ColorAccentRed}" />

    <!-- ================= FONTS & DIMENSIONS ================= -->
    <FontFamily x:Key="FontDefault">Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeXSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeMedium">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeXLarge">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>

    <sys:Double x:Key="SidebarCollapsedWidth">70</sys:Double>
    <sys:Double x:Key="SidebarExpandedWidth">260</sys:Double>
    <sys:Double x:Key="SidebarAnimationDuration">300</sys:Double>

    <!-- Font sizes are referenced in code-behind as numbers -->
    <!-- Use these as guides: XSmall=11, Small=12, Normal=13, Medium=14, Large=16, XLarge=18, Title=24 -->

    <!-- Sidebar dimensions referenced in code-behind -->
    <!-- CollapsedWidth=70, ExpandedWidth=260, AnimationDuration=300ms -->

    <!-- ================= ANIMATIONS ================= -->
    <!-- Animations are implemented in code-behind (MainWindow.xaml.cs) -->
    <!-- See AnimateSidebarToggle() method for smooth sidebar animation -->

    <!-- ================= BASE WINDOW STYLE ================= -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushWindowBg}" />
        <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
        <!--<Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />-->
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ================= TEXTBLOCK STYLE ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================= TEXTBOX STYLE ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= PASSWORD BOX STYLE ================= -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= COMBOBOX STYLE ================= -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ================= PRIMARY BUTTON ================= -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushPrimaryDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushPrimaryDark}" />
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= SECONDARY BUTTON ================= -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="#EEEEEE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderMedium}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DDDDDD" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#CCCCCC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccentGreen}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentGreen}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentGreen}" />
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentRed}" />
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TOP BAR ICON BUTTON ================= -->
    <Style x:Key="TopBarIconButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#20FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#30FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    <!-- ================= DATAGRID THEME ================= -->
    <Style TargetType="DataGrid">
        <Setter Property="RowBackground" Value="{StaticResource BrushCardBg}" />
        <Setter Property="AlternatingRowBackground" Value="#F7F8FD" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF2FF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimaryLight}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= MENU BUTTON STYLE ================= -->
    <Style x:Key="MenuButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= COMPATIBILITY STYLES ================= -->
    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style x:Key="FormTextBoxWithValidation" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
    <Style x:Key="FormComboBoxWithValidation" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

</ResourceDictionary>

<Window x:Class="POS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS System"
        WindowState="Maximized"
        Background="{StaticResource BrushWindowBg}"
        Loaded="Window_Loaded">

    <!-- ================= WINDOW RESOURCES ================= -->
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Icon Font -->
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ================= HAMBURGER BUTTON STYLE ================= -->
        <Style x:Key="HamburgerButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       FontFamily="{StaticResource IconFont}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= SIDEBAR MENU HEADER BUTTON STYLE ================= -->
        <Style x:Key="SidebarMenuHeaderStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Active Blue Bar (Left) -->
                            <Border x:Name="ActiveBar"
                                    Width="4"
                                    Background="{StaticResource BrushPrimary}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"/>

                            <!-- Background -->
                            <Border x:Name="BackgroundBorder"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Margin="6,1,6,1"
                                    Padding="6,4,6,4"/>

                            <!-- Content Container -->
                            <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="18"
                                           Width="28"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- Text -->
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                           x:Name="MenuText"/>
                            </Grid>
                            
                            <!-- Separator Line -->
                            <Border VerticalAlignment="Bottom" 
                                    BorderBrush="#20FFFFFF" 
                                    BorderThickness="0,0,0,1" 
                                    Margin="10,0,10,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                            </Trigger>

                            <!-- Active/Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource BrushSidebarActive}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= SIDEBAR SUBMENU BUTTON STYLE ================= -->
        <Style x:Key="SidebarSubMenuStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="38"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BackgroundBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="2,1,2,1"
                                    Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>

                                    <!-- Text -->
                                    <TextBlock Grid.Column="1"
                                               Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Separator Line -->
                            <Border VerticalAlignment="Bottom" 
                                    BorderBrush="#20FFFFFF" 
                                    BorderThickness="0,0,0,1" 
                                    Margin="12,0,12,0"
                                    SnapsToDevicePixels="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ================= ROOT GRID ================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" 
                x:Name="SidebarContainer"
                Width="260"
                Background="{StaticResource BrushSidebarBg}"
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="0" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- APP HEADER + TOGGLE BUTTON -->
                <StackPanel Grid.Row="0" Margin="12,15,12,8">

                    <!-- Logo & Title -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Logo Icon -->
                        <Ellipse Grid.Column="0"
                                 Width="32"
                                 Height="32"
                                 Fill="{StaticResource BrushPrimary}"
                                 VerticalAlignment="Center"/>

                        <!-- Title (Hidden when collapsed) -->
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    x:Name="SidebarTitle"
                                    Visibility="{Binding IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="POSPro"
                                       Foreground="{StaticResource BrushTextWhite}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       LineHeight="24"/>
                            <TextBlock Text="Pro"
                                       Foreground="{StaticResource BrushPrimary}"
                                       FontSize="12"
                                       Margin="0,-4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toggle Button -->
                    <ToggleButton x:Name="SidebarToggle"
                                  Content="&#xE700;"
                                  Style="{StaticResource HamburgerButtonStyle}"
                                  FontSize="20"
                                  HorizontalAlignment="Left"
                                  Click="SidebarToggle_Click" />
                </StackPanel>

                <!-- MENU LIST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Sales Menu -->
                        <ToggleButton x:Name="BtnSales"
                                      Content="Sales"
                                      Tag="&#xE719;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Products -->
                        <ToggleButton x:Name="BtnProducts"
                                      Content="Products"
                                      Tag="&#xE781;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Customers -->
                        <ToggleButton x:Name="BtnCustomers"
                                      Content="Customers"
                                      Tag="&#xE77B;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Suppliers -->
                        <ToggleButton x:Name="BtnSuppliers"
                                      Content="Suppliers"
                                      Tag="&#xE821;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Inventory -->
                        <ToggleButton x:Name="BtnInventory"
                                      Content="Inventory"
                                      Tag="&#xE8F1;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Payments -->
                        <ToggleButton x:Name="BtnPayments"
                                      Content="Payments"
                                      Tag="&#xE8C7;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Reports -->
                        <ToggleButton x:Name="BtnReports"
                                      Content="Reports"
                                      Tag="&#xE9D9;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Users -->
                        <ToggleButton x:Name="BtnUsers"
                                      Content="Users"
                                      Tag="&#xE779;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Organization -->
                        <ToggleButton x:Name="BtnOrganization"
                                      Content="Organization"
                                      Tag="&#xE80F;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Finance -->
                        <ToggleButton x:Name="BtnFinance"
                                      Content="Finance"
                                      Tag="&#xE8C6;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Settings -->
                        <ToggleButton x:Name="BtnSettings"
                                      Content="Settings"
                                      Tag="&#xE713;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Utilities -->
                        <ToggleButton x:Name="BtnUtilities"
                                      Content="Utilities"
                                      Tag="&#xE90F;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>

                        <!-- Session -->
                        <ToggleButton x:Name="BtnSession"
                                      Content="Session"
                                      Tag="&#xE72E;"
                                      Style="{StaticResource SidebarMenuHeaderStyle}"
                                      Click="Menu_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- LOGOUT BUTTON -->
                <ToggleButton Grid.Row="2"
                        Tag="&#xE7E8;"
                        Content="Logout"
                        Style="{StaticResource SidebarMenuHeaderStyle}"
                        Margin="0,0,0,12"
                        Foreground="{StaticResource BrushAccentRed}"
                        Click="Logout_Click"/>
            </Grid>
        </Border>

        <!-- ================= RIGHT PANEL WITH MENU, HEADER, CONTENT, STATUS BAR ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>


            <!-- TOP HEADER BAR WITH DARK BACKGROUND -->
            <Border Grid.Row="0" Background="{StaticResource BrushSidebarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <!-- Left side - Page title -->
                    <TextBlock Grid.Column="0"
                               x:Name="HeaderTitle"
                               Text="Billing / New Sale"
                               Foreground="{StaticResource BrushTextWhite}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>

                    <!-- Summary Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource TopBarIconButton}"
                            Content="&#xE9D2;"
                            Margin="0,0,10,0"
                            ToolTip="Summary"/>

                    <!-- Help Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource TopBarIconButton}"
                            Content="&#xE897;"
                            Margin="0,0,20,0"
                            ToolTip="Help"/>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA (hosts BillingView by default) -->
            <Grid Grid.Row="1">
                <Border Background="{StaticResource BrushWindowBg}" />
                <ContentControl x:Name="MainContent" />
            </Grid>

            <!-- STATUS BAR: User, Date/Time, Online status, Version -->
            <StatusBar Grid.Row="2" Background="{StaticResource BrushSidebarBg}" Foreground="{StaticResource BrushTextWhite}" FontSize="12" Padding="8,0">
                <StatusBarItem>
                    <TextBlock x:Name="StatusBarUser" Text="User: --" />
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBarDateTime" Text="" />
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBarOnline" Text="Online" />
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusBarVersion" Text="v1.0.0" />
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <!-- ================= SALES SUBMENU POPUP ================= -->
        <Popup x:Name="PopupSales"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnSales}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="{StaticResource BrushSidebarBg}"
                    Width="260"
                    Padding="5"
                    CornerRadius="0,8,8,0"
                    BorderThickness="2,1,1,1"
                    BorderBrush="{StaticResource BrushPrimary}">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="4"
                                      Opacity="0.35"/>
                </Border.Effect>

                <StackPanel>
                    <Button x:Name="BtnBilling" Click="SubMenuSales_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE7BF;" Content="Billing / New Sale"/>
                    <Button x:Name="BtnQuickSale" Click="SubMenuSales_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE7BF;" Content="Quick Sale"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE716;" Content="Held Bills"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE81C;" Content="Sales History"/>
                    <Button x:Name="BtnReturnsExchanges" Click="SubMenuSales_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE898;" Content="Returns &amp; Exchanges"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8C5;" Content="Quotations"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE80D;" Content="Delivery Orders"/>
                    <Button x:Name="BtnReprintInvoice" Click="SubMenuSales_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE749;" Content="Reprint Invoice"/>
                    <Button x:Name="BtnDayEnd" Click="SubMenuSales_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE89E;" Content="Day End / EOD Report"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= PRODUCTS SUBMENU POPUP ================= -->
        <Popup x:Name="PopupProducts"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnProducts}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <Button x:Name="BtnProductList" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE71D;" Content="Products (Item Master)"/>
                    <Button x:Name="BtnCategories" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8EC;" Content="Categories"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE90C;" Content="Sub-Categories"/>
                    <Button x:Name="BtnBrands" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE80B;" Content="Brands"/>
                    <Button x:Name="BtnUom" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE9A8;" Content="Units (UOM)"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE7F4;" Content="Variants"/>
                    <Button x:Name="BtnTaxProfiles" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE825;" Content="Tax Profiles"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE14D;" Content="Price Lists"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE737;" Content="Combo / Bundle Items"/>
                    <Button x:Name="BtnBarcodeManagement" Click="SubMenu_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE80A;" Content="Barcode Management"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8B6;" Content="Import / Export"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= CUSTOMERS SUBMENU POPUP ================= -->
        <Popup x:Name="PopupCustomers"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnCustomers}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <Button x:Name="BtnCustomerList" Click="SubMenuCustomers_Click" Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE77B;" Content="Customers"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE716;" Content="Customer Groups"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8A1;" Content="Loyalty Programs"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8C6;" Content="Credit Customers"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1E4;" Content="Outstanding / Dues"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE9F9;" Content="Customer Statements"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= SUPPLIERS SUBMENU POPUP ================= -->
        <Popup x:Name="PopupSuppliers"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnSuppliers}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE821;" Content="Suppliers"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8A1;" Content="Purchase Orders"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE896;" Content="Goods Receipt (GRN)"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE14D;" Content="Purchase Invoices"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE898;" Content="Purchase Returns"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8C7;" Content="Supplier Payments"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1E4;" Content="Supplier Outstanding"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= INVENTORY SUBMENU POPUP ================= -->
        <Popup x:Name="PopupInventory"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnInventory}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8F1;" Content="Stock Summary"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE118;" Content="Stock Inward"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE110;" Content="Stock Outward"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE13C;" Content="Stock Transfers"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE73F;" Content="Stock Adjustments"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE781;" Content="Physical Stock Count"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1E4;" Content="Batch / Expiry Tracking"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE896;" Content="Serial Number Tracking"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE7BA;" Content="Low Stock Alerts"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8B9;" Content="Reorder Management"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= PAYMENTS SUBMENU POPUP ================= -->
        <Popup x:Name="PopupPayments"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnPayments}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE753;" Content="Cash Register"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8C7;" Content="Cash In / Cash Out"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1C5;" Content="Payment Settlements"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1E4;" Content="Pending Payments"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8C6;" Content="Advance Receipts"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE161;" Content="Denominations"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE713;" Content="Payment Modes Setup"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= REPORTS SUBMENU POPUP ================= -->
        <Popup x:Name="PopupReports"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=BtnReports}"
               CustomPopupPlacementCallback="PopupPlacementCallback"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource BrushSidebarBg}" Width="260" Padding="5" CornerRadius="0,8,8,0" BorderThickness="2,1,1,1" BorderBrush="{StaticResource BrushPrimary}">
                <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <!-- Sales Reports Header -->
                    <TextBlock Text="Sales Reports" Foreground="{StaticResource BrushPrimary}" Margin="12,8,0,4" FontSize="12" FontWeight="Bold"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE787;" Content="Day / Month / Period"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE71D;" Content="Item Wise"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8EC;" Content="Category Wise"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE825;" Content="Tax / GST"/>
                    
                    <!-- Inventory Reports Header -->
                    <TextBlock Text="Inventory Reports" Foreground="{StaticResource BrushPrimary}" Margin="12,8,0,4" FontSize="12" FontWeight="Bold"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE8F1;" Content="Stock Summary"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE118;" Content="Fast / Slow Moving"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1E4;" Content="Expiry"/>
                    
                    <TextBlock Text="Other Reports" Foreground="{StaticResource BrushPrimary}" Margin="12,8,0,4" FontSize="12" FontWeight="Bold"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE821;" Content="Purchase Reports"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE77B;" Content="Customer Reports"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE821;" Content="Supplier Reports"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE779;" Content="Staff Performance"/>
                    <Button Style="{StaticResource SidebarSubMenuStyle}" Tag="&#xE1C5;" Content="Profit &amp; Loss"/>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================== BRUSHES ================== -->

    <!-- Primary (Save / Pay / OK) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D7"/>

    <!-- Secondary (Cancel / Reset / Back) -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#333"/>

    <!-- Success (Confirm / Complete / Receive Stock) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>

    <!-- Danger (Delete / Disable / Void Bill) -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>

    <!-- Warning (Hold / Pending / Attention) -->
    <SolidColorBrush x:Key="WarningBrush" Color="#ED6C02"/>

    <!-- Toolbar / Flat -->
    <SolidColorBrush x:Key="FlatHoverBrush" Color="#EEEEEE"/>


    <!-- ================== BASE BUTTON STYLE ================== -->

    <!-- Base style all buttons inherit from -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


    <!-- ================== PRIMARY BUTTON (SAVE / PAY) ================== -->

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#106EBE"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#005A9E"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#B0B0B0"/>
                <Setter Property="Foreground" Value="#666"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ================== SECONDARY BUTTON (CANCEL / RESET / BACK) ================== -->

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#BDBDBD"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D5D5D5"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#C0C0C0"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#999"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ================== SUCCESS BUTTON (CONFIRM / COMPLETE) ================== -->

    <Style x:Key="SuccessButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#388E3C"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#1B5E20"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ================== DANGER BUTTON (DELETE / DISABLE / VOID) ================== -->

    <Style x:Key="DangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D32F2F"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B71C1C"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ================== WARNING BUTTON (HOLD / PENDING) ================== -->

    <Style x:Key="WarningButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Foreground" Value="White"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F57C00"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E65100"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ================== FLAT / TOOLBAR BUTTON ================== -->

    <Style x:Key="FlatButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FlatHoverBrush}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#DDDDDD"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

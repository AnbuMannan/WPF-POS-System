<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:POS.UI.Core.Helpers">

    <!-- ========================================================= -->
    <!-- BASE TEXTBOX STYLE (USED EVERYWHERE)                     -->
    <!-- ========================================================= -->

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- 🔥 ENTER KEY MOVES TO NEXT CONTROL -->
        <Setter Property="helpers:EnterKeyTraversal.IsEnabled" Value="True"/>

        <!-- 🔥 AUTO SELECT TEXT ON FOCUS -->
        <Setter Property="helpers:AutoSelectBehavior.IsEnabled" Value="True"/>
    </Style>

    <!-- ========================================================= -->
    <!-- BASE COMBOBOX STYLE                                      -->
    <!-- ========================================================= -->

    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,4,0,4"/>

        <!-- 🔥 ENTER KEY MOVES TO NEXT CONTROL -->
        <Setter Property="helpers:EnterKeyTraversal.IsEnabled" Value="True"/>
    </Style>

    <!-- ========================================================= -->
    <!-- TEXTBOX WITH VALIDATION (NO JUMP, NO OVERLAP, STABLE)    -->
    <!-- ========================================================= -->

    <Style x:Key="FormTextBoxWithValidation"
           TargetType="TextBox"
           BasedOn="{StaticResource FormTextBox}">

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>

                        <!-- Two rows: control + fixed error space -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <!-- fixed space -->
                        </Grid.RowDefinitions>

                        <!-- Original control -->
                        <AdornedElementPlaceholder Grid.Row="0"/>

                        <!-- Error message -->
                        <TextBlock Grid.Row="1"
                                   Foreground="Red"
                                   FontSize="11"
                                   Margin="4,2,0,0"
                                   Text="{Binding [0].ErrorContent}"
                                   Visibility="{Binding HasError,
                                                        RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ========================================================= -->
    <!-- COMBOBOX WITH VALIDATION (NO JUMP, NO OVERLAP)           -->
    <!-- ========================================================= -->

    <Style x:Key="FormComboBoxWithValidation"
           TargetType="ComboBox"
           BasedOn="{StaticResource FormComboBox}">

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>

                        <!-- Two rows: control + fixed error space -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>

                        <!-- Original control -->
                        <AdornedElementPlaceholder Grid.Row="0"/>

                        <!-- Error message -->
                        <TextBlock Grid.Row="1"
                                   Foreground="Red"
                                   FontSize="11"
                                   Margin="4,2,0,0"
                                   Text="{Binding [0].ErrorContent}"
                                   Visibility="{Binding HasError,
                                                        RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>

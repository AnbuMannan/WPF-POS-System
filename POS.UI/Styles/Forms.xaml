<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:POS.UI.Core.Helpers"
    xmlns:conv="clr-namespace:POS.UI.Core.Converters">

    <!-- ========================================================= -->
    <!-- BASE TEXTBOX STYLE (USED EVERYWHERE)                     -->
    <!-- ========================================================= -->

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- 🔥 ENTER KEY MOVES TO NEXT CONTROL -->
        <Setter Property="helpers:EnterKeyTraversal.IsEnabled" Value="True"/>

        <!-- 🔥 AUTO SELECT TEXT ON FOCUS -->
        <Setter Property="helpers:AutoSelectBehavior.IsEnabled" Value="True"/>
    </Style>

    <!-- ========================================================= -->
    <!-- BASE COMBOBOX STYLE: defined in BrandTheme.xaml (global). -->
    <!-- FormComboBoxWithValidation below extends it.              -->
    <!-- ========================================================= -->

    <!-- ========================================================= -->
    <!-- TEXTBOX WITH VALIDATION (NO JUMP, NO OVERLAP, STABLE)    -->
    <!-- ========================================================= -->

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <conv:FirstValidationErrorConverter x:Key="FirstValidationErrorConverter"/>

    <Style x:Key="FormTextBoxWithValidation"
           TargetType="TextBox"
           BasedOn="{StaticResource FormTextBox}">

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>

                        <!-- Two rows: control + fixed error space -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <!-- fixed space -->
                        </Grid.RowDefinitions>

                        <!-- Original control -->
                        <AdornedElementPlaceholder Grid.Row="0"/>

                        <!-- Error message -->
                        <TextBlock Grid.Row="1"
                                   Foreground="Red"
                                   FontSize="11"
                                   Margin="4,2,0,0"
                                   Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                                   Visibility="{Binding (Validation.HasError), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ========================================================= -->
    <!-- COMBOBOX WITH VALIDATION (NO JUMP, NO OVERLAP)           -->
    <!-- ========================================================= -->

    <Style x:Key="FormComboBoxWithValidation"
           TargetType="ComboBox"
           BasedOn="{StaticResource FormComboBox}">
        <!-- FormComboBox from BrandTheme.xaml (center-aligned) -->

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>

                        <!-- Two rows: control + fixed error space -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>

                        <!-- Original control -->
                        <AdornedElementPlaceholder Grid.Row="0"/>

                        <!-- Error message -->
                        <TextBlock Grid.Row="1"
                                   Foreground="Red"
                                   FontSize="11"
                                   Margin="4,2,0,0"
                                   Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                                   Visibility="{Binding (Validation.HasError), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== TOP LEVEL MENU STYLE (Master / Transaction / Reports) ===== -->
    <Style x:Key="PosTopMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#F5F5F5"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <!-- Header Area -->
                        <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="4"
                            Margin="6,0"
                            Padding="4,0">

                            <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <!-- 🔥 SUBMENU POPUP HOST (VERY IMPORTANT) -->
                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">

                            <Border Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2"
                                SnapsToDevicePixels="True">

                                <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#5C6BC0"/>
                        </Trigger>

                        <!-- Active / Open -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#303F9F"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#AAA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===== SUB MENU STYLE (Dropdown + Sub-Sub menus) ===== -->
    <Style x:Key="PosSubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#222"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent">
                        <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="2">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter ContentSource="Header"
                                              Margin="12,4"
                                              VerticalAlignment="Center"/>

                                <!-- Arrow for sub-sub menus -->
                                <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 0 8"
                                  Stroke="#666"
                                  StrokeThickness="2"/>
                            </Grid>
                        </Border>

                        <!-- Popup for sub-sub menus -->
                        <Popup x:Name="PART_Popup"
                           Placement="Right"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">

                            <Border Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">

                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EEF0FF"/>
                        </Trigger>

                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
